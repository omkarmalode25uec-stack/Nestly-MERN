<% layout('layouts/boilerplate') %>

<!-- Breadcrumb & Fast Action Bar -->
<section class="w-full bg-surface-container-lowest border-b border-outline-variant/30 sticky top-20 z-40 shadow-sm">
  <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin py-space-sm flex flex-wrap items-center justify-between gap-space-sm">
    <nav aria-label="Breadcrumbs" class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md">
      <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
        <span class="material-symbols-outlined text-[16px] text-primary">home</span>
        <span>Home</span>
      </a>
      <span class="text-outline-variant">/</span>
      <a href="/stays?city=<%= property.city %>" class="hover:text-primary transition-colors"><%= property.city %></a>
      <span class="text-outline-variant">/</span>
      <span class="text-on-surface font-semibold truncate max-w-[200px] sm:max-w-none"><%= property.title %></span>
    </nav>

    <!-- Owner Actions (if current user is owner) or Student Actions -->
    <div class="flex items-center gap-space-xs">
      <% if (typeof currentUser !== 'undefined' && currentUser && property.owner && property.owner._id.equals(currentUser._id)) { %>
        <a href="/stays/<%= property._id %>/edit" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md flex items-center gap-1.5 transition-colors font-semibold">
          <span class="material-symbols-outlined text-[18px]">edit</span>
          <span>Edit Listing</span>
        </a>
        <form action="/stays/<%= property._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');">
          <button type="submit" class="px-3 py-1.5 rounded-lg bg-error-container hover:opacity-90 text-on-error-container font-label-md text-label-md flex items-center gap-1.5 transition-colors font-semibold">
            <span class="material-symbols-outlined text-[18px]">delete</span>
            <span>Delete</span>
          </button>
        </form>
      <% } else { %>
        <% const isSavedInShow = typeof currentUser !== 'undefined' && currentUser && currentUser.savedProperties && currentUser.savedProperties.some(id => id.toString() === property._id.toString()); %>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <form action="<%= isSavedInShow ? '/stays/' + property._id + '/unsave' : '/stays/' + property._id + '/save' %>" method="POST" class="inline">
            <button type="submit" class="px-3 py-1.5 rounded-lg <%= isSavedInShow ? 'bg-secondary-container text-on-secondary-container font-semibold' : 'bg-surface-container-low hover:bg-surface-container text-on-surface' %> font-label-md text-label-md flex items-center gap-1.5 transition-colors" title="<%= isSavedInShow ? 'Remove from shortlist' : 'Save to shortlist' %>">
              <span class="material-symbols-outlined text-[18px] text-primary" style="<%= isSavedInShow ? 'font-variation-settings: \'FILL\' 1;' : '' %>"><%= isSavedInShow ? 'bookmark' : 'bookmark_border' %></span>
              <span class="hidden sm:inline"><%= isSavedInShow ? 'Shortlisted' : 'Shortlist' %></span>
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md flex items-center gap-1.5 transition-colors" title="Sign in to shortlist">
            <span class="material-symbols-outlined text-[18px] text-secondary">bookmark_border</span>
            <span class="hidden sm:inline">Shortlist</span>
          </a>
        <% } %>
        <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md flex items-center gap-1.5 transition-colors" onclick="navigator.clipboard && navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
          <span class="material-symbols-outlined text-[18px] text-secondary">share</span>
          <span class="hidden sm:inline">Share</span>
        </button>
      <% } %>
    </div>
  </div>
</section>

<div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin w-full py-space-md">
  <!-- Property Header Info -->
  <header class="mb-space-lg">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm uppercase tracking-wider font-bold">
        <span class="material-symbols-outlined text-[15px] text-primary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
        Nestly Verified Audit
      </span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm font-semibold">
        <span class="material-symbols-outlined text-[15px]">meeting_room</span>
        <%= property.propertyType %> • <%= property.genderPreference %>
      </span>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-sm text-label-sm font-bold">
        <span class="material-symbols-outlined text-[15px] text-tertiary" style="font-variation-settings: 'FILL' 1;">star</span>
        <%= property.rating || 4.8 %> <span class="font-normal opacity-80">(<%= property.reviewCount || 24 %> Verified Reviews)</span>
      </span>
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm">
      <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">
          <%= property.title %>
        </h1>
        <p class="mt-1 flex items-center gap-1 text-on-surface-variant font-body-md text-body-md flex-wrap">
          <span class="material-symbols-outlined text-[18px] text-primary">location_on</span>
          <span><%= property.address %>, <%= property.locality %>, <%= property.city %></span>
          <span class="text-outline mx-1">•</span>
          <span class="text-secondary font-medium"><%= property.campusDistance %></span>
        </p>
      </div>
      <div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm">
        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
        <span>Admissions Open for Semester</span>
      </div>
    </div>
  </header>

  <!-- Flipkart / Amazon Style Interactive Photo Gallery -->
  <%
    const defaultPlaceholder = 'https://lh3.googleusercontent.com/aida-public/AB6AXuBgBDIxb-WpmtqzQeuCJSuSq2xX8QDvXr1slAGbURtXyJxN1EqB7ZQN2uJsIR2IHJAeFy8PJBYdzTUXtXauyeiyJGJ_hIkT7iD6LFwF3Kv2furgx1OFHMa3IgG6pkdwEkXtd1oaVY81xlSKh_4wY83NF4dvK1FY7rV1QydaTNCcnwXskfd2UVBLHS0jGhK42ss_rQBeQ4JTh6BZjWV5_73HR08RwMDZlbIk5AJMDqAewgHwnHt0Qoul';
    const rawImages = (property.images && Array.isArray(property.images)) ? property.images : [];
    const galleryImages = rawImages.length > 0 
      ? rawImages.map(img => (img && img.url) ? img.url : (img ? img.toString() : defaultPlaceholder)).filter(Boolean)
      : [defaultPlaceholder];
    const hasMultipleImages = galleryImages.length > 1;
  %>
  <section class="relative mb-space-2xl rounded-2xl overflow-hidden border border-outline-variant/30 bg-surface-container-low shadow-sm select-none" id="propertyGalleryContainer">
    <!-- Main Viewport -->
    <div class="relative w-full h-[360px] sm:h-[460px] md:h-[520px] bg-neutral-900 flex items-center justify-center overflow-hidden group">
      <!-- Active Image -->
      <img 
        id="galleryMainImg" 
        src="<%= galleryImages[0] %>" 
        alt="<%= property.title %> photo" 
        class="w-full h-full object-cover transition-opacity duration-300 ease-in-out select-none"
      />

      <!-- Room Sharing Badge -->
      <div class="absolute top-4 left-4 z-10 flex items-center gap-2 pointer-events-none">
        <span class="px-3 py-1 bg-surface/90 backdrop-blur-md rounded-xl font-label-sm text-label-sm text-primary font-bold shadow-sm flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-primary">apartment</span>
          <%= property.roomSharing %> Room Suite
        </span>
      </div>

      <% if (hasMultipleImages) { %>
        <!-- Floating Left Arrow -->
        <button 
          type="button" 
          id="galleryPrevBtn" 
          onclick="prevGalleryImage(event)" 
          aria-label="Previous photo"
          class="absolute left-3 md:left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface/90 hover:bg-surface text-on-surface shadow-lg backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer"
        >
          <span class="material-symbols-outlined text-[28px]">keyboard_arrow_left</span>
        </button>

        <!-- Floating Right Arrow -->
        <button 
          type="button" 
          id="galleryNextBtn" 
          onclick="nextGalleryImage(event)" 
          aria-label="Next photo"
          class="absolute right-3 md:right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-surface/90 hover:bg-surface text-on-surface shadow-lg backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer"
        >
          <span class="material-symbols-outlined text-[28px]">keyboard_arrow_right</span>
        </button>
      <% } %>
    </div>

    <% if (hasMultipleImages) { %>
      <!-- Shopping-App Style Centered Counter Bar (2 / 6) -->
      <div class="bg-surface-container-low py-2 px-4 flex items-center justify-between border-t border-outline-variant/20">
        <span class="text-xs text-on-surface-variant font-medium hidden sm:inline">Use arrows or thumbnails to explore</span>
        <div id="galleryCounter" class="mx-auto sm:mx-0 px-3.5 py-1 rounded-full bg-surface-container-high text-on-surface font-label-md text-label-md font-bold shadow-sm flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-primary">photo_library</span>
          <span><span id="galleryCurrentIndex">1</span> / <span><%= galleryImages.length %></span></span>
        </div>
        <span class="text-xs text-on-surface-variant font-medium hidden sm:inline">Tap photo or thumbnails</span>
      </div>

      <!-- Thumbnail Strip (Flipkart / Amazon Style) -->
      <div class="bg-surface-container-lowest border-t border-outline-variant/20 p-2 sm:p-3">
        <div 
          id="galleryThumbnailStrip" 
          class="flex items-center gap-2 sm:gap-3 overflow-x-auto scrollbar-thin py-1 px-1 scroll-smooth"
        >
          <% galleryImages.forEach((imgUrl, idx) => { %>
            <button 
              type="button"
              onclick="setGalleryImage(<%= idx %>)"
              class="gallery-thumbnail relative shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition-all duration-200 cursor-pointer focus:outline-none <%= idx === 0 ? 'border-primary ring-2 ring-primary/40 opacity-100 scale-[1.02]' : 'border-outline-variant/40 opacity-60 hover:opacity-100 hover:border-primary/50' %>"
              data-index="<%= idx %>"
              aria-label="View photo <%= idx + 1 %>"
            >
              <img 
                src="<%= imgUrl %>" 
                alt="<%= property.title %> thumbnail <%= idx + 1 %>" 
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>
  </section>

  <% if (hasMultipleImages) { %>
    <script>
      (function() {
        const images = <%- JSON.stringify(galleryImages) %>;
        if (!images || images.length <= 1) return;

        let currentIndex = 0;
        const mainImg = document.getElementById('galleryMainImg');
        const counterEl = document.getElementById('galleryCurrentIndex');
        const thumbnails = document.querySelectorAll('.gallery-thumbnail');

        function updateGallery(idx) {
          if (idx < 0) {
            currentIndex = images.length - 1; // Looping to last image
          } else if (idx >= images.length) {
            currentIndex = 0; // Looping to first image
          } else {
            currentIndex = idx;
          }

          // Smooth fade transition
          if (mainImg) {
            mainImg.style.opacity = '0.4';
            mainImg.src = images[currentIndex];
            mainImg.onload = function() {
              mainImg.style.opacity = '1';
            };
          }

          // Update counter badge
          if (counterEl) {
            counterEl.textContent = currentIndex + 1;
          }

          // Update thumbnails highlight & scroll into view
          thumbnails.forEach((thumb, i) => {
            if (i === currentIndex) {
              thumb.classList.add('border-primary', 'ring-2', 'ring-primary/40', 'opacity-100', 'scale-[1.02]');
              thumb.classList.remove('border-outline-variant/40', 'opacity-60');
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              thumb.classList.remove('border-primary', 'ring-2', 'ring-primary/40', 'opacity-100', 'scale-[1.02]');
              thumb.classList.add('border-outline-variant/40', 'opacity-60');
            }
          });
        }

        window.nextGalleryImage = function(e) {
          if (e) e.stopPropagation();
          updateGallery(currentIndex + 1);
        };

        window.prevGalleryImage = function(e) {
          if (e) e.stopPropagation();
          updateGallery(currentIndex - 1);
        };

        window.setGalleryImage = function(idx) {
          updateGallery(idx);
        };

        // Keyboard Left/Right Navigation
        document.addEventListener('keydown', function(e) {
          if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
          if (e.key === 'ArrowLeft') {
            updateGallery(currentIndex - 1);
          } else if (e.key === 'ArrowRight') {
            updateGallery(currentIndex + 1);
          }
        });

        // Touch Swipe Navigation for Mobile
        let touchStartX = 0;
        let touchEndX = 0;
        const container = document.getElementById('propertyGalleryContainer');
        if (container) {
          container.addEventListener('touchstart', function(e) {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          container.addEventListener('touchend', function(e) {
            touchEndX = e.changedTouches[0].screenX;
            const swipeDist = touchEndX - touchStartX;
            if (Math.abs(swipeDist) > 40) {
              if (swipeDist < 0) {
                updateGallery(currentIndex + 1); // Swipe left -> next
              } else {
                updateGallery(currentIndex - 1); // Swipe right -> prev
              }
            }
          }, { passive: true });
        }
      })();
    </script>
  <% } %>

  <!-- Two-Column Main Content -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
    <!-- Left Column (Overview, Amenities, Details) -->
    <div class="lg:col-span-8 space-y-space-xl">
      <!-- Residency Narrative -->
      <section class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/30 space-y-space-md">
        <div class="flex items-center justify-between pb-space-sm border-b border-surface-container-low">
          <div>
            <h2 class="font-title-lg text-title-lg text-on-surface font-bold">Residency Overview</h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              Managed by <%= property.owner ? property.owner.name : 'Nestly Partner Host' %>
            </p>
          </div>
          <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-primary font-bold">
            <span class="material-symbols-outlined text-[22px]">school</span>
          </div>
        </div>

        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed whitespace-pre-line">
          <%= property.description %>
        </p>

        <!-- Key Highlights Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-space-sm bg-surface-container-low p-4 rounded-xl">
          <div class="flex flex-col items-center text-center p-2">
            <span class="material-symbols-outlined text-primary text-[28px] mb-1">wifi</span>
            <span class="font-label-md text-label-md font-bold text-on-surface">Wi-Fi</span>
            <span class="font-body-sm text-body-sm text-outline">High Speed</span>
          </div>
          <div class="flex flex-col items-center text-center p-2">
            <span class="material-symbols-outlined text-primary text-[28px] mb-1">restaurant</span>
            <span class="font-label-md text-label-md font-bold text-on-surface">Meals</span>
            <span class="font-body-sm text-body-sm text-outline">Hygienic Mess</span>
          </div>
          <div class="flex flex-col items-center text-center p-2">
            <span class="material-symbols-outlined text-primary text-[28px] mb-1">local_laundry_service</span>
            <span class="font-label-md text-label-md font-bold text-on-surface">Laundry</span>
            <span class="font-body-sm text-body-sm text-outline">Washer Facility</span>
          </div>
          <div class="flex flex-col items-center text-center p-2">
            <span class="material-symbols-outlined text-primary text-[28px] mb-1">shield_person</span>
            <span class="font-label-md text-label-md font-bold text-on-surface">24/7 Security</span>
            <span class="font-body-sm text-body-sm text-outline">Biometric & CCTV</span>
          </div>
        </div>
      </section>

      <!-- Amenities Section -->
      <section class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/30 space-y-space-md">
        <h2 class="font-title-lg text-title-lg text-on-surface font-bold">Included Amenities</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <% (property.amenities || []).forEach(amenity => { %>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-surface-container-low text-on-surface">
              <span class="material-symbols-outlined text-primary text-[20px]">check_circle</span>
              <span class="font-label-md text-label-md font-semibold"><%= amenity %></span>
            </div>
          <% }) %>
        </div>
      </section>

      <!-- Location & Neighborhood Mapbox Section -->
      <%
        const propLat = (property.location && property.location.latitude) ? property.location.latitude : 19.8913;
        const propLng = (property.location && property.location.longitude) ? property.location.longitude : 74.4784;
        const googleMapsDirectUrl = (property.location && property.location.googleMapsUrl) 
          ? property.location.googleMapsUrl 
          : `https://www.google.com/maps/search/?api=1&query=${propLat},${propLng}`;
      %>
      <section class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/30 space-y-space-md" id="locationSection">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-space-xs border-b border-surface-container-low">
          <div>
            <h2 class="font-title-lg text-title-lg text-on-surface font-bold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-primary text-[22px]">location_on</span>
              Location &amp; Neighborhood
            </h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              <%= property.address %>, <%= property.locality %>, <%= property.city %>
            </p>
          </div>
          <a href="<%= googleMapsDirectUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-primary font-label-sm text-label-sm font-bold border border-outline-variant/30 transition-colors self-start sm:self-auto shrink-0 shadow-xs">
            <span class="material-symbols-outlined text-[16px]">directions</span>
            <span>Get Directions</span>
          </a>
        </div>

        <% if (property.campusDistance) { %>
          <div class="flex items-center gap-2 p-3 rounded-xl bg-secondary-container/40 text-on-surface text-sm">
            <span class="material-symbols-outlined text-secondary text-[20px] shrink-0">near_me</span>
            <span><strong>Campus Proximity:</strong> <%= property.campusDistance %></span>
          </div>
        <% } %>

        <!-- Mapbox Interactive Map -->
        <div class="relative w-full h-64 sm:h-72 rounded-xl overflow-hidden border border-outline-variant/40 shadow-xs">
          <div id="propertyShowMap" class="w-full h-full" data-lat="<%= propLat %>" data-lng="<%= propLng %>" data-title="<%= property.title %>" data-token="<%= typeof mapboxToken !== 'undefined' ? mapboxToken : '' %>"></div>
        </div>

        <div class="flex items-center justify-between text-xs text-on-surface-variant pt-0.5">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-emerald-600 text-[16px]">verified</span>
            <span>Verified stay within Nestly Kopargaon Service Scope</span>
          </span>
          <span class="font-mono text-[11px] text-outline"><%= Number(propLat).toFixed(4) %>, <%= Number(propLng).toFixed(4) %></span>
        </div>
      </section>

      <script>
        (function() {
          const mapEl = document.getElementById('propertyShowMap');
          if (!mapEl) return;
          const token = mapEl.dataset.token;
          if (!token || token === 'undefined' || typeof mapboxgl === 'undefined') return;

          const lat = parseFloat(mapEl.dataset.lat) || 19.8913;
          const lng = parseFloat(mapEl.dataset.lng) || 74.4784;
          const title = mapEl.dataset.title || 'Student Stay';

          mapboxgl.accessToken = token;
          const showMap = new mapboxgl.Map({
            container: mapEl,
            style: 'mapbox://styles/mapbox/streets-v12',
            center: [lng, lat],
            zoom: 15
          });

          showMap.addControl(new mapboxgl.NavigationControl({ showCompass: true }), 'top-right');

          const popup = new mapboxgl.Popup({ offset: 25 }).setHTML(`
            <div class="p-1 font-sans">
              <div class="font-bold text-xs text-gray-900">${title}</div>
              <div class="text-[11px] text-gray-600">Nestly Verified Stay</div>
            </div>
          `);

          new mapboxgl.Marker({ color: '#006a4e' })
            .setLngLat([lng, lat])
            .setPopup(popup)
            .addTo(showMap);
        })();
      </script>

      <!-- Stitch Reviews & Ratings Section -->
      <section class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/30 space-y-space-lg" id="reviews">
        <!-- Reviews Header & Overall Rating -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pb-space-sm border-b border-surface-container">
          <div>
            <h2 class="font-title-lg text-title-lg text-on-surface font-bold">Student Reviews &amp; Ratings</h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Verified student feedback on food, Wi-Fi, safety and accommodation</p>
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-secondary-container/40">
            <span class="material-symbols-outlined text-amber-500 text-[22px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="font-headline-sm text-headline-sm font-bold text-on-surface"><%= property.rating || '4.8' %></span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">
              (<%= (typeof reviews !== 'undefined' && reviews ? reviews.length : 0) || property.reviewCount || 0 %> <%= (typeof reviews !== 'undefined' && reviews && reviews.length === 1) ? 'Review' : 'Reviews' %>)
            </span>
          </div>
        </div>

        <!-- Submit Review Form Container -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="p-space-md rounded-2xl bg-surface-container-low border border-outline-variant/30 space-y-space-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[20px]">rate_review</span>
              <h3 class="font-title-md text-title-md text-on-surface font-bold">Write a Student Review</h3>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Share your experience to help fellow students find their ideal stay.</p>

            <form action="/stays/<%= property._id %>/reviews" method="POST" class="space-y-space-sm pt-1" id="addReviewForm">
              <!-- Star Rating Selection -->
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold mb-1">Your Rating</label>
                <div class="flex items-center gap-2 flex-wrap">
                  <% [5, 4, 3, 2, 1].forEach(starVal => { %>
                    <label class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-surface-container-lowest hover:bg-secondary-container/30 cursor-pointer border border-outline-variant/30 text-xs font-semibold text-on-surface transition-all has-[:checked]:bg-secondary-container has-[:checked]:border-primary">
                      <input type="radio" name="rating" value="<%= starVal %>" class="accent-primary" <%= starVal === 5 ? 'checked' : '' %> required/>
                      <span><%= starVal %></span>
                      <span class="material-symbols-outlined text-amber-500 text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                    </label>
                  <% }) %>
                </div>
              </div>

              <!-- Comment Textarea -->
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold mb-1" for="reviewComment">Your Feedback</label>
                <textarea name="comment" id="reviewComment" rows="3" required minlength="3" placeholder="How was the room, cleanliness, Wi-Fi stability, mess food, and curfew policy?" class="w-full p-3 rounded-xl bg-surface-container-lowest text-on-surface font-body-sm text-body-sm border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
              </div>

              <div class="flex justify-end">
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-md text-label-md font-bold transition-all shadow-sm">
                  <span class="material-symbols-outlined text-[18px]">send</span>
                  <span>Post Verified Review</span>
                </button>
              </div>
            </form>
          </div>
        <% } else { %>
          <!-- Guest Prompt -->
          <div class="p-space-md rounded-xl bg-surface-container-low border border-outline-variant/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[22px]">lock</span>
              <span class="text-on-surface font-medium">Have you stayed at <%= property.title %>? Sign in to post a verified resident review.</span>
            </div>
            <a href="/login" class="inline-flex items-center gap-1 px-4 py-2 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold hover:bg-on-primary-fixed-variant transition-colors self-start sm:self-auto shrink-0">
              <span>Sign In to Review</span>
            </a>
          </div>
        <% } %>

        <!-- Review Cards Feed -->
        <div class="space-y-4">
          <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
            <% reviews.forEach(review => { %>
              <article class="p-4 rounded-xl bg-surface border border-outline-variant/20 space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-secondary-container text-primary font-bold flex items-center justify-center font-label-md text-label-md uppercase">
                      <%= (review.author && review.author.name) ? review.author.name.split(' ').map(n => n[0]).join('').slice(0, 2) : 'VR' %>
                    </div>
                    <div>
                      <div class="flex items-center gap-1.5">
                        <h4 class="font-label-md text-label-md font-bold text-on-surface">
                          <%= review.author ? review.author.name : 'Verified Resident' %>
                        </h4>
                        <span class="material-symbols-outlined text-[15px] text-primary" style="font-variation-settings: 'FILL' 1;">verified</span>
                        <span class="font-label-sm text-label-sm text-secondary">Verified Resident</span>
                      </div>
                      <p class="font-body-sm text-body-sm text-outline">
                        <%= (review.author && review.author.college) ? review.author.college : 'Student Resident' %>
                      </p>
                    </div>
                  </div>

                  <!-- Star Rating Display -->
                  <div class="flex text-amber-500 shrink-0">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' <%= i <= review.rating ? 1 : 0 %>;">star</span>
                    <% } %>
                  </div>
                </div>

                <!-- Comment Body -->
                <p class="font-body-md text-body-md text-on-surface-variant pt-1">
                  "<%= review.comment %>"
                </p>

                <!-- Review Meta & Authorized Delete -->
                <div class="flex items-center justify-between pt-1 border-t border-surface-container text-outline font-body-sm text-body-sm">
                  <span>Reviewed on <%= new Date(review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>

                  <% if (typeof currentUser !== 'undefined' && currentUser && review.author && (review.author.equals ? review.author.equals(currentUser._id) : review.author._id.toString() === currentUser._id.toString())) { %>
                    <form action="/stays/<%= property._id %>/reviews/<%= review._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete your review?');" class="inline-block">
                      <button type="submit" class="text-error hover:underline font-label-sm text-label-sm flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px]">delete</span>
                        <span>Delete</span>
                      </button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <!-- Empty Reviews State -->
            <div class="p-space-lg rounded-xl bg-surface text-center space-y-2 border border-outline-variant/20">
              <span class="material-symbols-outlined text-primary text-[32px]">rate_review</span>
              <p class="font-title-md text-title-md font-bold text-on-surface">No student reviews yet</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm mx-auto">
                Be the first verified resident to share your experience living at <%= property.title %>!
              </p>
            </div>
          <% } %>
        </div>
      </section>
    </div>

    <!-- Right Sticky Reservation & Booking Column -->
    <aside class="lg:col-span-4 sticky top-36 space-y-space-md">
      <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-md border border-outline-variant/30 space-y-space-md">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-label-sm text-label-sm text-outline uppercase block"><%= property.roomSharing %> Room</span>
            <div class="flex items-baseline gap-1">
              <span class="font-headline-lg text-headline-lg font-bold text-primary">₹<%= property.price.toLocaleString('en-IN') %></span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">/ month</span>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold">
            Zero Brokerage
          </span>
        </div>

        <div class="space-y-2 text-body-sm border-t border-b border-surface-container py-3">
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Refundable Deposit</span>
            <span class="font-semibold text-on-surface">₹<%= property.securityDeposit.toLocaleString('en-IN') %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">First Month Rent</span>
            <span class="font-bold text-primary">₹<%= property.price.toLocaleString('en-IN') %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Available Beds</span>
            <span class="font-semibold text-secondary"><%= property.availableBeds %> Beds Remaining</span>
          </div>
        </div>

        <!-- Reservation CTA Button -> Leads to Booking & Unit Reservation Request -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/stays/<%= property._id %>/book" class="w-full py-3.5 px-4 rounded-xl bg-primary hover:bg-on-primary-fixed-variant active:scale-[0.98] transition-all text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20">
            <span>Reserve Bed &amp; Hold Unit</span>
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </a>
        <% } else { %>
          <a href="/login" class="w-full py-3.5 px-4 rounded-xl bg-primary hover:bg-on-primary-fixed-variant active:scale-[0.98] transition-all text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20">
            <span>Sign In to Reserve Unit</span>
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </a>
        <% } %>

        <!-- Warden Contact -->
        <% if (property.contactPhone || (property.owner && property.owner.phone)) { %>
          <div class="p-3 bg-surface-container-low rounded-xl flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-[24px]">call</span>
            <div class="leading-tight">
              <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Contact Warden / Host</span>
              <p class="font-label-md text-label-md text-on-surface font-bold"><%= property.contactPhone || property.owner.phone %></p>
            </div>
          </div>
        <% } %>

        <div class="flex items-center justify-center gap-2 text-outline text-label-sm font-label-sm pt-1">
          <span class="material-symbols-outlined text-[14px] text-primary">shield</span>
          <span>Secure Payment Processing</span>
        </div>
      </div>
    </aside>
  </div>
</div>
