<!-- Interactive Client-side Script for Gender Preference Segmented Toggle -->
<script>
  (function() {
    const genderContainer = document.getElementById('genderSegmentedContainer');
    if (!genderContainer) return;

    const radios = genderContainer.querySelectorAll('input[type="radio"][name="gender"]');
    const labels = genderContainer.querySelectorAll('.gender-toggle-btn');

    function syncGenderUI() {
      radios.forEach((radio) => {
        const label = radio.closest('label');
        if (!label) return;
        if (radio.checked) {
          label.classList.add('bg-surface-container-lowest', 'shadow-sm', 'text-primary', 'font-bold');
          label.classList.remove('text-on-surface-variant');
        } else {
          label.classList.remove('bg-surface-container-lowest', 'shadow-sm', 'text-primary', 'font-bold');
          label.classList.add('text-on-surface-variant');
        }
      });
    }

    radios.forEach((radio) => {
      radio.addEventListener('change', syncGenderUI);
    });

    labels.forEach((label) => {
      label.addEventListener('click', function() {
        const radio = this.querySelector('input[type="radio"]') || document.getElementById(this.getAttribute('for'));
        if (radio && !radio.checked) {
          radio.checked = true;
          syncGenderUI();
        }
      });
    });

    // Ensure accurate UI state on initial load
    syncGenderUI();

    // Budget Preset Chips Handler
    const budgetRange = document.getElementById('budgetRange');
    const budgetDisplay = document.getElementById('budgetDisplay');
    const budgetChips = document.querySelectorAll('.budget-preset-chip');

    if (budgetRange && budgetDisplay) {
      const updateBudgetHighlight = (val) => {
        budgetChips.forEach(chip => {
          const chipVal = chip.dataset.price;
          if (chipVal === String(val) || (!chipVal && (!val || val >= 25000))) {
            chip.classList.add('bg-surface-container-lowest', 'text-primary', 'font-bold', 'shadow-sm', 'ring-1', 'ring-primary/20');
            chip.classList.remove('text-on-surface-variant', 'border-transparent');
          } else {
            chip.classList.remove('bg-surface-container-lowest', 'text-primary', 'font-bold', 'shadow-sm', 'ring-1', 'ring-primary/20');
            chip.classList.add('text-on-surface-variant', 'border-transparent');
          }
        });
      };

      budgetChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const val = chip.dataset.price;
          budgetRange.value = val || 25000;
          budgetDisplay.innerText = val ? 'Max ₹' + Number(val).toLocaleString('en-IN') : 'Any Budget';
          updateBudgetHighlight(val);
        });
      });

      budgetRange.addEventListener('input', () => {
        const val = Number(budgetRange.value);
        budgetDisplay.innerText = val >= 25000 ? 'Any Budget' : 'Max ₹' + val.toLocaleString('en-IN');
        updateBudgetHighlight(val >= 25000 ? '' : val);
      });
    }

    // Filter Card Checkbox Active Style Synchronizer
    document.querySelectorAll('.filter-card-checkbox').forEach(lbl => {
      const chk = lbl.querySelector('input[type="checkbox"]');
      if (!chk) return;

      const syncCheckboxUI = () => {
        if (chk.checked) {
          lbl.classList.add('bg-surface-container-lowest', 'shadow-xs', 'text-primary', 'font-bold', 'ring-1', 'ring-primary/20');
          lbl.classList.remove('bg-surface-container-low', 'text-on-surface');
        } else {
          lbl.classList.remove('bg-surface-container-lowest', 'shadow-xs', 'text-primary', 'font-bold', 'ring-1', 'ring-primary/20');
          lbl.classList.add('bg-surface-container-low', 'text-on-surface');
        }
      };

      chk.addEventListener('change', syncCheckboxUI);
    });
  })();

  // Slide-over Filter Drawer Controller (Smooth overlay drawer without taking listing grid space)
  (function() {
    const drawer = document.getElementById('filterDrawer');
    const backdrop = document.getElementById('filterDrawerBackdrop');
    const toggleBtn = document.getElementById('filterDrawerToggleBtn');
    const closeBtn = document.getElementById('closeFilterDrawerBtn');

    if (!drawer || !backdrop || !toggleBtn) return;

    let isOpen = false;

    function openDrawer() {
      isOpen = true;
      drawer.classList.remove('-translate-x-full');
      drawer.classList.add('translate-x-0');

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      document.body.classList.add('overflow-hidden');
    }

    function closeDrawer() {
      isOpen = false;
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('-translate-x-full');

      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      document.body.classList.remove('overflow-hidden');
    }

    function toggleDrawer() {
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    }

    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleDrawer();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        closeDrawer();
      });
    }

    backdrop.addEventListener('click', function(e) {
      e.preventDefault();
      closeDrawer();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    });
  })();
</script>
