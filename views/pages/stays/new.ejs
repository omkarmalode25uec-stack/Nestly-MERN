<% layout('layouts/boilerplate') %>

<div class="max-w-3xl mx-auto px-margin-mobile md:px-margin py-space-xl">
  <div class="bg-surface-container-lowest p-space-lg md:p-space-xl rounded-3xl shadow-sm border border-outline-variant/30 space-y-space-md">
    <!-- Header -->
    <div class="border-b border-outline-variant/30 pb-space-md">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold uppercase mb-2">
        <span class="material-symbols-outlined text-[15px]">add_business</span>
        Property Owner Portal
      </div>
      <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface">List Your Student Accommodation</h1>
      <p class="font-body-md text-body-md text-on-surface-variant mt-1">
        Reach 45,000+ verified college students seeking trusted hostels, PGs, and shared stays.
      </p>
    </div>

    <!-- Form -->
    <form action="/stays" method="POST" enctype="multipart/form-data" class="space-y-space-md">
      <!-- Section 1: Basic Information -->
      <div class="space-y-3">
        <h3 class="font-title-md text-title-md font-bold text-on-surface">1. Basic Property Details</h3>
        
        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="title">Property Title / Name *</label>
          <input name="title" id="title" placeholder="e.g. Green Valley Premier PG & Student Residency" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required autofocus/>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="propertyType">Accommodation Type *</label>
            <select name="propertyType" id="propertyType" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required>
              <option value="PG">Paying Guest (PG)</option>
              <option value="Hostel">Student Hostel</option>
              <option value="Shared Flat">Shared Flat / Apartment</option>
              <option value="Co-Living">Student Co-Living</option>
            </select>
          </div>

          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="genderPreference">Occupant Gender *</label>
            <select name="genderPreference" id="genderPreference" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required>
              <option value="Boys">Boys Only</option>
              <option value="Girls">Girls Only</option>
              <option value="Unisex" selected>Co-Ed / Unisex</option>
            </select>
          </div>

          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="roomSharing">Room Sharing *</label>
            <select name="roomSharing" id="roomSharing" class="w-full px-3 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required>
              <option value="Single">Single (Private)</option>
              <option value="Double" selected>Double / Twin Sharing</option>
              <option value="Triple">Triple Sharing</option>
              <option value="Four+">Four+ Sharing</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="description">Property Description *</label>
          <textarea name="description" id="description" rows="3" placeholder="Describe room amenities, study desks, food schedule, curfew rules, and hostel atmosphere..." class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required></textarea>
        </div>
      </div>

      <!-- Section 2: Location Details -->
      <div class="space-y-4 pt-2 border-t border-outline-variant/30">
        <div class="flex items-center justify-between">
          <h3 class="font-title-md text-title-md font-bold text-on-surface">2. Location & Campus Proximity</h3>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container">Service Area: Kopargaon</span>
        </div>

        <!-- Mapbox Interactive Location Picker Container -->
        <div id="mapboxLocationPicker" data-token="<%= typeof mapboxToken !== 'undefined' ? mapboxToken : '' %>" class="space-y-3 p-3 sm:p-4 rounded-2xl bg-surface-container-low border border-outline-variant/30">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <label class="block font-label-md text-label-md text-on-surface font-bold">
              Property Location
            </label>
            <div class="flex items-center gap-2">
              <button type="button" id="useCurrentLocationBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-primary font-label-sm text-label-sm font-bold border border-outline-variant/30 transition-all shadow-xs cursor-pointer">
                <span>📍</span>
                <span>Use my current location</span>
              </button>
              <button type="button" id="chooseOnMapBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-bold border border-outline-variant/30 transition-all shadow-xs cursor-pointer">
                <span>🗺️</span>
                <span>Choose on map</span>
              </button>
            </div>
          </div>

          <!-- Search Property Location Bar -->
          <div class="relative">
            <div class="relative flex items-center">
              <span class="material-symbols-outlined text-[18px] text-outline absolute left-3 pointer-events-none">search</span>
              <input type="text" id="mapboxSearchInput" placeholder="Search property location (e.g. Sai City, Sanjivani College, Sahajanandnagar...)" autocomplete="off" class="w-full pl-9 pr-8 py-2.5 bg-surface-container-lowest border border-outline-variant/40 rounded-xl text-body-md text-on-surface outline-none focus:border-primary focus:ring-1 focus:ring-primary text-sm shadow-xs"/>
              <button type="button" id="mapboxSearchClearBtn" class="hidden absolute right-2.5 text-on-surface-variant hover:text-on-surface text-base font-bold leading-none p-1 cursor-pointer" title="Clear search">&times;</button>
            </div>
            <!-- Autocomplete Suggestions List -->
            <ul id="mapboxSuggestionsList" class="hidden absolute top-full left-0 right-0 mt-1 bg-surface-container-lowest border border-outline-variant/40 rounded-xl shadow-lg z-50 max-h-56 overflow-y-auto no-scrollbar"></ul>
          </div>

          <!-- Location Alert / Status Box -->
          <div id="locationAlertContainer" class="hidden"></div>

          <!-- Mapbox Interactive Map Container -->
          <div class="relative rounded-xl overflow-hidden border border-outline-variant/40 bg-surface-container-lowest shadow-xs">
            <div id="mapboxMapContainer" class="w-full h-64 sm:h-72"></div>
            <div class="absolute bottom-2 left-2 pointer-events-none bg-surface-container-lowest/90 backdrop-blur-xs px-2 py-1 rounded-md text-[10px] text-on-surface font-medium shadow-xs">
              Drag green pin or click on map to position stay
            </div>
          </div>

          <!-- Location Selected Confirmation Card -->
          <div id="locationConfirmationCard" class="hidden p-3 rounded-xl bg-surface-container-lowest border border-primary/20 shadow-xs">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-primary text-[22px] mt-0.5" style="font-variation-settings: 'FILL' 1;">location_on</span>
                <div>
                  <h4 class="font-label-md text-label-md font-bold text-on-surface flex items-center gap-1.5">
                    <span>Property Location</span>
                    <span class="text-emerald-700 bg-emerald-100 font-bold px-1.5 py-0.5 rounded-md text-[10px] leading-none">✓ Selected</span>
                  </h4>
                  <p id="confirmedAddressText" class="font-body-sm text-body-sm text-on-surface-variant font-medium mt-0.5 leading-snug">Sai City, Kopargaon</p>
                  <div class="flex items-center gap-3 mt-1 text-[11px] text-outline font-mono">
                    <span>Lat: <strong id="confirmedLatText" class="text-on-surface font-semibold">-</strong></span>
                    <span>Lng: <strong id="confirmedLngText" class="text-on-surface font-semibold">-</strong></span>
                  </div>
                </div>
              </div>
              <button type="button" id="changeLocationBtn" class="text-xs font-semibold text-primary hover:underline shrink-0 cursor-pointer pt-0.5">
                Change Location
              </button>
            </div>
          </div>

          <!-- Hidden Form Fields for Coordinates -->
          <input type="hidden" name="latitude" id="latitudeInput" value="" />
          <input type="hidden" name="longitude" id="longitudeInput" value="" />

          <!-- Optional Google Maps URL Fallback -->
          <div class="pt-1">
            <button type="button" id="toggleGoogleMapsUrlBtn" class="text-xs text-on-surface-variant hover:text-primary font-medium inline-flex items-center gap-1 transition-colors cursor-pointer">
              <span>Have a Google Maps link?</span>
              <span class="text-primary underline">Paste it here (Optional)</span>
            </button>
            <div id="googleMapsUrlContainer" class="hidden mt-1.5">
              <input type="url" name="googleMapsUrl" id="googleMapsUrlInput" placeholder="https://maps.app.goo.gl/... or https://google.com/maps?q=..." class="w-full px-3 py-2 bg-surface-container-lowest border border-outline-variant/40 rounded-xl text-body-sm text-on-surface outline-none focus:border-primary text-xs" />
              <p class="text-[11px] text-outline mt-0.5">Optional reference link. The map coordinates above remain the primary location.</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="city">City (Active Scope) *</label>
            <input name="city" id="city" value="Kopargaon" readonly class="w-full px-4 py-2.5 bg-surface-container rounded-xl text-body-md text-on-surface outline-none cursor-not-allowed font-medium" required/>
            <p class="text-[11px] text-on-surface-variant mt-0.5">Nestly currently serves Kopargaon, Maharashtra.</p>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="locality">Locality / Area in Kopargaon *</label>
            <input name="locality" id="locality" placeholder="e.g. Sahajanandnagar, Sai City, Mewad, Station Rd" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required/>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="address">Complete Street Address *</label>
          <input name="address" id="address" placeholder="e.g. Plot 18, near Sanjivani College of Engineering, Sahajanandnagar, Kopargaon" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required/>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="campusDistance">Proximity to Campuses / Landmarks</label>
          <input name="campusDistance" id="campusDistance" placeholder="e.g. 400m from Sanjivani College of Engineering • 5 mins walk" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary"/>
        </div>
      </div>

      <!-- Section 3: Pricing & Inventory -->
      <div class="space-y-3 pt-2 border-t border-outline-variant/30">
        <h3 class="font-title-md text-title-md font-bold text-on-surface">3. Rent & Bed Availability</h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="price">Monthly Rent (₹) *</label>
            <input type="number" name="price" id="price" placeholder="8500" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" required min="0"/>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="securityDeposit">Security Deposit (₹)</label>
            <input type="number" name="securityDeposit" id="securityDeposit" placeholder="8500" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" min="0"/>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="availableBeds">Available Beds</label>
            <input type="number" name="availableBeds" id="availableBeds" value="3" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary" min="0"/>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="contactPhone">Host / Warden Contact Number</label>
          <input name="contactPhone" id="contactPhone" placeholder="+91 98765 43210" class="w-full px-4 py-2.5 bg-surface-container-low border border-outline-variant/50 rounded-xl text-body-md text-on-surface outline-none focus:bg-surface-container-lowest focus:border-primary"/>
        </div>
      </div>

      <!-- Section 4: Amenities Checklist -->
      <div class="space-y-3 pt-2 border-t border-outline-variant/30">
        <h3 class="font-title-md text-title-md font-bold text-on-surface">4. Included Amenities</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-body-sm">
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="High-Speed Wi-Fi" checked class="accent-primary w-4 h-4"/>
            <span>High-Speed Wi-Fi</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="3x Meals (Mess Included)" checked class="accent-primary w-4 h-4"/>
            <span>3x Meals (Mess)</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="Air Conditioning (AC)" class="accent-primary w-4 h-4"/>
            <span>Air Conditioning (AC)</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="Washing Machine / Laundry" checked class="accent-primary w-4 h-4"/>
            <span>Laundry Service</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="Power Backup (24/7)" checked class="accent-primary w-4 h-4"/>
            <span>Power Backup (24/7)</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="Attached Washroom" class="accent-primary w-4 h-4"/>
            <span>Attached Bath</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="Biometric / CCTV Security" checked class="accent-primary w-4 h-4"/>
            <span>Biometric Security</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container">
            <input type="checkbox" name="amenities" value="No Curfew / Flexible Entry" class="accent-primary w-4 h-4"/>
            <span>Flexible Curfew</span>
          </label>
        </div>
      </div>

      <!-- Section 5: Property Photos Upload (Multer + Cloudinary) -->
      <div class="space-y-3 pt-2 border-t border-outline-variant/30">
        <div class="flex items-center justify-between">
          <h3 class="font-title-md text-title-md font-bold text-on-surface flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">add_photo_alternate</span>
            <span>5. Property Photos (Upload Images)</span>
          </h3>
          <span class="font-label-sm text-label-sm text-outline">Max 10 photos • JPG, PNG, WEBP</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">
          Select or drag-and-drop authentic accommodation photos. Recommended shots:
        </p>

        <!-- Recommended Photo Categories Pills -->
        <div class="flex flex-wrap gap-1.5 text-xs text-on-surface-variant">
          <span class="px-2.5 py-1 rounded-full bg-surface-container flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-primary">bed</span> Room / Beds
          </span>
          <span class="px-2.5 py-1 rounded-full bg-surface-container flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-primary">bathtub</span> Ensuite Bathroom
          </span>
          <span class="px-2.5 py-1 rounded-full bg-surface-container flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-primary">soup_kitchen</span> Kitchen / Mess
          </span>
          <span class="px-2.5 py-1 rounded-full bg-surface-container flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-primary">apartment</span> Building Exterior
          </span>
          <span class="px-2.5 py-1 rounded-full bg-surface-container flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-primary">meeting_room</span> Common Study Area
          </span>
        </div>

        <!-- Custom Drag-and-Drop / File Upload Box -->
        <div id="dropZoneBox" class="relative border-2 border-dashed border-outline-variant/60 hover:border-primary rounded-2xl p-6 text-center bg-surface-container-low transition-colors cursor-pointer group" onclick="document.getElementById('propertyImagesInput').click()">
          <input type="file" id="propertyImagesInput" name="images" multiple accept="image/jpeg,image/png,image/webp,image/jpg" class="hidden" onchange="previewSelectedImages(event)"/>
          
          <div class="flex flex-col items-center justify-center gap-2">
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[28px]">cloud_upload</span>
            </div>
            <div>
              <p class="font-label-lg text-label-lg font-bold text-on-surface">Click to select photos or drag &amp; drop files</p>
              <p class="font-body-sm text-body-sm text-outline mt-0.5">Photos are securely processed and hosted on Cloudinary</p>
            </div>
            <button type="button" class="mt-1 px-4 py-1.5 rounded-lg bg-surface-container text-primary font-label-sm text-label-sm font-semibold group-hover:bg-primary group-hover:text-on-primary transition-colors pointer-events-none">
              Browse Files
            </button>
          </div>
        </div>

        <!-- Live Preview Grid of Selected Images -->
        <div id="imagePreviewContainer" class="hidden space-y-2 pt-2">
          <div class="flex items-center justify-between text-label-sm font-semibold text-on-surface">
            <span id="previewCountText">Selected Photos Preview:</span>
            <button type="button" onclick="clearSelectedImages()" class="text-error hover:underline text-xs flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">close</span> Clear All
            </button>
          </div>
          <div id="previewGrid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-2.5"></div>
        </div>
      </div>

      <!-- Submit Buttons -->
      <div class="pt-space-md flex items-center justify-end gap-3 border-t border-outline-variant/30">
        <a href="/stays" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold transition-colors">
          Cancel
        </a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-md text-label-md font-bold shadow-md transition-all">
          Publish Stay Listing
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewSelectedImages(event) {
    const input = event.target;
    const container = document.getElementById('imagePreviewContainer');
    const grid = document.getElementById('previewGrid');
    const countText = document.getElementById('previewCountText');

    if (!input.files || input.files.length === 0) {
      container.classList.add('hidden');
      grid.innerHTML = '';
      return;
    }

    grid.innerHTML = '';
    countText.textContent = `${input.files.length} Photo${input.files.length > 1 ? 's' : ''} Ready to Upload:`;
    container.classList.remove('hidden');

    Array.from(input.files).forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = function(e) {
        const div = document.createElement('div');
        div.className = 'relative aspect-[4/3] rounded-xl overflow-hidden bg-surface-container border border-outline-variant/40 shadow-sm';
        div.innerHTML = `
          <img src="${e.target.result}" alt="Preview ${index + 1}" class="w-full h-full object-cover"/>
          <span class="absolute bottom-1 left-1 px-1.5 py-0.5 bg-black/60 text-white rounded text-[10px] font-mono font-medium">#${index + 1}</span>
        `;
        grid.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  }

  function clearSelectedImages() {
    const input = document.getElementById('propertyImagesInput');
    input.value = '';
    document.getElementById('imagePreviewContainer').classList.add('hidden');
    document.getElementById('previewGrid').innerHTML = '';
  }

  // Drag and drop listeners for instant multi-photo upload
  const dropBox = document.getElementById('dropZoneBox');
  if (dropBox) {
    ['dragenter', 'dragover'].forEach((eventName) => {
      dropBox.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropBox.classList.add('border-primary', 'bg-surface-container');
      }, false);
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropBox.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropBox.classList.remove('border-primary', 'bg-surface-container');
      }, false);
    });

    dropBox.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      const input = document.getElementById('propertyImagesInput');
      if (files && files.length > 0) {
        input.files = files;
        previewSelectedImages({ target: input });
      }
    }, false);
  }
</script>
<script src="/js/locationPicker.js"></script>
