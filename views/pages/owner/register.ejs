<% layout('layouts/boilerplate') %>

<div class="w-full min-h-[calc(100vh-5rem)] flex flex-col lg:flex-row items-stretch justify-center p-4 lg:p-8 max-w-[1400px] mx-auto">
  <!-- Left Hero & Partner Network Pillars (45% on Desktop) -->
  <div class="lg:w-[45%] flex flex-col justify-between p-8 lg:p-12 rounded-3xl bg-surface-container-low shadow-sm relative overflow-hidden mb-6 lg:mb-0 lg:mr-6">
    <!-- Ambient Blur Backgrounds -->
    <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-secondary-container/30 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-12 -bottom-12 w-80 h-80 rounded-full bg-primary-fixed/20 blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <div class="flex items-center space-x-3 mb-8">
        <img alt="Nestly Logo" class="w-12 h-12 rounded-xl object-contain shadow-sm bg-surface-container-lowest p-1.5" src="https://lh3.googleusercontent.com/aida/AEtjO1XLBIdjlCwhQsm14iVWPL4BA8vuEWIrL4mCZhzV_IBld6duoNfbZePWMm84Xbt4KHzUC_mxBa5lUBxy_0OpaNSUoAYrpwmjWTgg0d16lZTFZXGNGOMuAMBZVzetVn-mSYufYmpFikmiydFD5V7AazFoWnIFybcGClPZwzDYFlNZa5tL1DcDA1lRHYXDY64lVR7RKgxfd6vT7BKm-OrWZFmFUsZCjS37KUQ9fRtCp3-FL_9_PjXyxB5vxT4"/>
        <div class="flex flex-col">
          <span class="font-headline-sm text-headline-sm text-primary tracking-tight font-bold">Nestly</span>
          <span class="font-label-sm text-label-sm text-secondary font-semibold uppercase tracking-wider">Owner &amp; Partner Network</span>
        </div>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container/50 text-secondary mb-6">
        <span class="material-symbols-outlined text-base" style="font-variation-settings: 'FILL' 1;">domain</span>
        <span class="font-label-md text-label-md">Kopargaon Campus Hostels &amp; PGs</span>
      </div>

      <h1 class="font-display text-display-mobile lg:text-display text-on-surface font-bold tracking-tight leading-tight mb-4">
        Fill your student beds with <span class="text-primary-container">zero listing fees.</span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg mb-8 leading-relaxed">
        Join verified accommodation owners near Sanjivani College, Sahajanandnagar, and Station Road connecting directly with students.
      </p>

      <!-- Trust Pillars -->
      <div class="space-y-4 mb-8">
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-xl">verified</span>
          </div>
          <div>
            <span class="font-title-md text-title-md text-on-surface font-semibold block">Campus Verified Partner Badge</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">Our team audits safety, amenities, and food standards to give students confidence.</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-xl">lock</span>
          </div>
          <div>
            <span class="font-title-md text-title-md text-on-surface font-semibold block">Protected Token Holds &amp; Direct UPI</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">Receive advance holds and security deposits with 100% transparent tracking.</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0">
            <span class="material-symbols-outlined text-xl">speed</span>
          </div>
          <div>
            <span class="font-title-md text-title-md text-on-surface font-semibold block">Zero Brokerage, Zero Commmissions</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">Direct warden-to-student communication without middlemen cut.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Security & Audit Note -->
    <div class="relative z-10 bg-surface-container-lowest p-4 rounded-2xl shadow-sm flex items-center gap-3 border border-outline-variant/30">
      <span class="material-symbols-outlined text-primary text-[24px]">policy</span>
      <div class="leading-tight text-on-surface">
        <p class="font-label-md text-label-md font-bold">Safe Campus Architecture</p>
        <p class="font-body-sm text-body-sm text-on-surface-variant">All owner accounts are audited by Nestly before properties appear in student searches.</p>
      </div>
    </div>
  </div>

  <!-- Right Form Column (55% on Desktop) -->
  <div class="lg:w-[55%] flex flex-col justify-between p-6 lg:p-12 bg-surface-container-lowest rounded-3xl shadow-sm border border-outline-variant/30">
    <!-- Top Nav Switcher -->
    <div class="flex items-center justify-between pb-4 mb-2 border-b border-outline-variant/20">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider">Property Owner Registration</span>
      </div>
      <a class="inline-flex items-center gap-1 font-label-lg text-label-lg text-secondary hover:text-primary transition-colors font-semibold" href="/signup">
        <span>Student? Switch to Student Sign Up</span>
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>

    <!-- Registration Form Wrapper -->
    <div class="max-w-md w-full mx-auto my-auto py-3">
      <div class="mb-5">
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight mb-1">
          Partner with Nestly
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Create your property owner account to begin the campus verification process.
        </p>
      </div>

      <!-- Form (POST /owner/register) -->
      <form action="/owner/register" method="POST" class="space-y-3.5">
        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="name">
            Owner / Warden Full Name *
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-on-surface-variant text-xl">person</span>
            <input name="name" class="w-full pl-11 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all placeholder:text-on-surface-variant/60" id="name" placeholder="e.g. Rameshwar Patil" type="text" required autofocus/>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="businessName">
            Hostel / PG / Business Name
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-on-surface-variant text-xl">apartment</span>
            <input name="businessName" class="w-full pl-11 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all placeholder:text-on-surface-variant/60" id="businessName" placeholder="e.g. Sai Krupa Boys Hostel &amp; Mess" type="text"/>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="ownerType">
            Owner / Operator Role *
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-on-surface-variant text-xl">badge</span>
            <select name="ownerType" id="ownerType" class="w-full pl-11 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all">
              <option value="individual">Individual Property Owner / Landlord</option>
              <option value="hostel_warden">Hostel Warden / Rector</option>
              <option value="pg_operator">PG Operator / Manager</option>
              <option value="property_manager">Facility Incharge / Real Estate Manager</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="email">
              Contact Email *
            </label>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-lg">alternate_email</span>
              <input name="email" class="w-full pl-10 pr-3 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all placeholder:text-on-surface-variant/60" id="email" placeholder="owner@saikrupa.com" type="email" required/>
            </div>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="phone">
              Mobile Number (WhatsApp) *
            </label>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-lg">call</span>
              <input name="phone" class="w-full pl-10 pr-3 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all placeholder:text-on-surface-variant/60" id="phone" placeholder="98220 00000" type="tel" required/>
            </div>
          </div>
        </div>

        <div>
          <label class="block font-label-md text-label-md text-on-surface font-semibold mb-1" for="password">
            Create Password *
          </label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-on-surface-variant text-xl">lock</span>
            <input name="password" class="w-full pl-11 pr-12 py-2.5 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md rounded-xl shadow-sm outline-none focus:border-primary focus:bg-surface-container-low transition-all placeholder:text-on-surface-variant/60" id="password" placeholder="At least 6 characters" type="password" minlength="6" required/>
            <button aria-label="Show or hide password" class="absolute right-3.5 p-1 rounded text-on-surface-variant hover:text-on-surface transition-colors" id="toggle-password" type="button">
              <span class="material-symbols-outlined text-xl" id="eye-icon">visibility</span>
            </button>
          </div>
        </div>

        <!-- Payment & Settlement Information (Optional) -->
        <div class="p-3.5 bg-surface-container-low/70 rounded-xl border border-outline-variant/30 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5 font-label-md text-label-md font-bold text-on-surface">
              <span class="material-symbols-outlined text-primary text-[18px]">account_balance_wallet</span>
              <span>Payout &amp; Settlement Account</span>
            </div>
            <span class="font-label-sm text-label-sm text-outline font-medium">Optional (Setup Later)</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant">
            Provide the UPI ID or bank account where token deposits will be disbursed once students confirm bookings.
          </p>

          <div>
            <label class="block font-label-sm text-label-sm text-on-surface font-semibold mb-1">Payout Method</label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-2 p-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest cursor-pointer hover:border-primary transition-colors text-label-sm font-label-sm text-on-surface">
                <input type="radio" name="settlementMethod" value="upi" checked onchange="toggleRegMethod('upi')">
                <span>UPI ID (VPA)</span>
              </label>
              <label class="flex items-center gap-2 p-2 rounded-lg border border-outline-variant/50 bg-surface-container-lowest cursor-pointer hover:border-primary transition-colors text-label-sm font-label-sm text-on-surface">
                <input type="radio" name="settlementMethod" value="bank_transfer" onchange="toggleRegMethod('bank')">
                <span>Bank Transfer</span>
              </label>
            </div>
          </div>

          <div id="reg-upi-group">
            <label class="block font-label-sm text-label-sm text-on-surface font-semibold mb-1" for="upiId">Receiving UPI ID (VPA)</label>
            <div class="relative flex items-center">
              <span class="material-symbols-outlined absolute left-3 text-on-surface-variant text-lg">qr_code</span>
              <input name="upiId" id="upiId" type="text" placeholder="e.g. saikrupa@okhdfcbank" class="w-full pl-9 pr-3 py-2 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-sm text-body-sm rounded-lg outline-none focus:border-primary"/>
            </div>
          </div>

          <div id="reg-bank-group" class="space-y-2" style="display: none;">
            <div>
              <label class="block font-label-sm text-label-sm text-on-surface font-semibold mb-1" for="accountHolderName">Bank Account Holder Name</label>
              <input name="accountHolderName" id="accountHolderName" type="text" placeholder="As per bank passbook" class="w-full px-3 py-2 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-sm text-body-sm rounded-lg outline-none focus:border-primary"/>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface font-semibold mb-1" for="accountNumber">Account Number</label>
                <input name="accountNumber" id="accountNumber" type="text" placeholder="Bank account number" class="w-full px-3 py-2 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-sm text-body-sm rounded-lg outline-none focus:border-primary"/>
              </div>
              <div>
                <label class="block font-label-sm text-label-sm text-on-surface font-semibold mb-1" for="ifscCode">IFSC Code</label>
                <input name="ifscCode" id="ifscCode" type="text" placeholder="e.g. HDFC0001234" class="w-full px-3 py-2 bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-sm text-body-sm rounded-lg outline-none focus:border-primary uppercase"/>
              </div>
            </div>
          </div>

          <div class="p-2.5 rounded-lg bg-surface-container border border-outline-variant/20 flex items-start gap-2 text-outline text-[11px] leading-tight">
            <span class="material-symbols-outlined text-[15px] text-primary shrink-0 mt-0.5">lock</span>
            <span><strong>Nestly Security Guarantee:</strong> We will NEVER ask for your UPI PIN, ATM PIN, OTP, or net banking password. Payout accounts are strictly for receiving deposits.</span>
          </div>
        </div>

        <div class="p-3 bg-secondary-container/40 rounded-xl text-on-secondary-container text-body-sm font-body-sm space-y-1 border border-secondary/20">
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 mt-0.5">verified</span>
            <span><strong>Instant Partner Activation:</strong> Your owner account is active immediately. You can list rooms and receive student booking requests right away.</span>
          </div>
        </div>

        <div class="pt-2">
          <button class="w-full py-3.5 px-6 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow-md hover:bg-on-primary-fixed-variant transition-all duration-200 transform active:scale-[0.99] flex items-center justify-center gap-2" type="submit">
            <span>Register Owner Account</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Bottom Account Switchers -->
    <div class="pt-4 mt-2 text-center space-y-2 border-t border-outline-variant/20">
      <p class="font-body-sm text-body-sm text-on-surface-variant">
        Already have a partner account? 
        <a class="text-primary font-semibold hover:underline" href="/login">Sign in here</a>
      </p>
      <p class="font-body-sm text-body-sm text-on-surface-variant">
        Looking for a room to stay? 
        <a class="text-secondary font-semibold hover:underline" href="/signup">Sign up as a Student</a>
      </p>
    </div>
  </div>
</div>

<script>
  (function() {
    const passwordInput = document.getElementById('password');
    const toggleBtn = document.getElementById('toggle-password');
    const eyeIcon = document.getElementById('eye-icon');

    if (toggleBtn && passwordInput && eyeIcon) {
      toggleBtn.addEventListener('click', function() {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
      });
    }

    window.toggleRegMethod = function(type) {
      const upiGroup = document.getElementById('reg-upi-group');
      const bankGroup = document.getElementById('reg-bank-group');
      if (type === 'bank') {
        if (upiGroup) upiGroup.style.display = 'none';
        if (bankGroup) bankGroup.style.display = 'block';
      } else {
        if (upiGroup) upiGroup.style.display = 'block';
        if (bankGroup) bankGroup.style.display = 'none';
      }
    };
  })();
</script>
