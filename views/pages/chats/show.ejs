<% layout('layouts/boilerplate') %>

<% 
  const partner = isOwner ? chat.student : chat.owner;
  const partnerRoleName = isOwner ? 'Student Resident' : 'Accommodation Host';
%>

<div class="relative w-full min-h-[calc(100vh-80px)] bg-surface py-space-md md:py-space-lg">
  <div class="max-w-4xl mx-auto px-margin-mobile md:px-margin flex flex-col h-[calc(100vh-140px)]">

    <!-- Top Conversation Header -->
    <div class="p-space-md rounded-t-2xl bg-surface-container-lowest border-t border-x border-outline-variant/30 shadow-sm flex items-center justify-between gap-space-sm shrink-0">
      
      <!-- Back & Partner Details -->
      <div class="flex items-center gap-space-sm min-w-0">
        <a href="/chats" class="p-2 rounded-xl hover:bg-surface-container text-on-surface-variant transition-colors" title="Back to Inbox">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>

        <div class="relative">
          <img class="w-10 h-10 rounded-full object-cover ring-1 ring-outline-variant/40" src="<%= (partner && partner.avatar) ? partner.avatar : 'https://lh3.googleusercontent.com/aida-public/AB6AXuAAqpTMQUCkhceotbCDpxAeWqtXHfAaUd_MvLbHpoUKqbSReNrdROy2OxJ61b2HqePtFbEMVR10ceaXifCBtpESiztRrvm8YE-x5_CI3jGo4SfPWrOHiQ8ZEMQWrK4aFi6A_w_5fYZW8xVmq0M2Wfi2nQl26KqZ1Y9c-Gd9B8S9ay1POG96lryJev6l73TDl0uvnogfOth_Tx2LfXvMyBHZr4hxiN1CYSdO86eYigQFE-EKDCs9yeUs' %>" alt="<%= partner ? partner.name : 'User' %>"/>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-surface-container-lowest"></span>
        </div>

        <div class="space-y-0.5 min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <h2 class="font-title-md text-title-md text-on-surface font-bold truncate">
              <%= partner ? partner.name : partnerRoleName %>
            </h2>
            <% if (!isOwner && partner && partner.verificationStatus === 'verified') { %>
              <span class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-[10px] font-bold flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[12px]">verified</span>
                Verified Host
              </span>
            <% } %>
            <% if (isOwner && partner && partner.college) { %>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-medium truncate max-w-[140px]">
                <%= partner.college %>
              </span>
            <% } %>
          </div>
          <p class="text-xs text-on-surface-variant truncate">
            Regarding: <strong class="text-on-surface"><%= chat.property ? chat.property.title : 'Accommodation' %></strong> • <span class="capitalize text-secondary font-medium"><%= chat.topic || 'General' %></span>
          </p>
        </div>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-1.5 shrink-0">
        <% if (chat.property) { %>
          <a href="/stays/<%= chat.property._id %>" class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm font-semibold transition-colors" target="_blank">
            <span class="material-symbols-outlined text-[15px]">open_in_new</span>
            <span>View Stay</span>
          </a>
        <% } %>

        <!-- Report conversation toggle -->
        <button type="button" onclick="document.getElementById('reportModal').classList.remove('hidden')" class="p-2 rounded-lg text-outline hover:text-error hover:bg-error-container/30 transition-colors" title="Report conversation">
          <span class="material-symbols-outlined text-[18px]">flag</span>
        </button>
      </div>

    </div>

    <!-- Message Stream -->
    <div id="messagesContainer" class="flex-1 overflow-y-auto p-space-md md:p-space-lg bg-surface-container-lowest/50 border-x border-outline-variant/30 space-y-space-md">
      
      <!-- Conversation Started Banner -->
      <div class="text-center space-y-1 py-space-sm border-b border-outline-variant/20">
        <span class="text-[11px] uppercase tracking-wider text-outline font-semibold">End-to-End In-App Chat</span>
        <p class="text-xs text-on-surface-variant">
          Inquiry on <strong class="text-on-surface"><%= chat.property ? chat.property.title : 'Stay' %></strong> started on <%= new Date(chat.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </p>
      </div>

      <!-- Messages Loop -->
      <% if (chat.messages && chat.messages.length > 0) { %>
        <% chat.messages.forEach(msg => { %>
          <% 
            const isMe = msg.sender && msg.sender.toString() === currentUser._id.toString();
          %>
          <div class="flex <%= isMe ? 'justify-end' : 'justify-start' %>">
            <div class="max-w-[80%] sm:max-w-[70%] space-y-1">
              <div class="p-3.5 rounded-2xl <%= isMe ? 'bg-primary text-on-primary rounded-br-xs shadow-sm' : 'bg-surface-container text-on-surface rounded-bl-xs' %>">
                <p class="text-sm font-normal leading-relaxed whitespace-pre-wrap break-words"><%= msg.text %></p>
              </div>
              <div class="flex items-center gap-1.5 px-1 <%= isMe ? 'justify-end' : 'justify-start' %> text-[10px] text-outline">
                <span><%= new Date(msg.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
                <% if (isMe) { %>
                  <span class="material-symbols-outlined text-[13px] <%= msg.read ? 'text-primary' : 'text-outline-variant' %>">done_all</span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-on-surface-variant text-sm">
          No messages sent yet. Start the conversation below.
        </div>
      <% } %>

    </div>

    <!-- Bottom Message Input Composer -->
    <div class="p-space-md rounded-b-2xl bg-surface-container-lowest border-b border-x border-outline-variant/30 shadow-sm shrink-0">
      <form action="/chats/<%= chat._id %>/message" method="POST" id="replyForm" class="flex items-end gap-space-sm">
        <div class="flex-1 relative">
          <textarea id="replyTextarea" name="text" rows="1" maxlength="1000" required placeholder="Type your message here (e.g. ask about rules, move-in flexibility)..." class="w-full py-2.5 px-3.5 rounded-xl bg-surface-container-low border border-outline-variant/40 focus:border-primary focus:ring-1 focus:ring-primary text-sm text-on-surface outline-none resize-none transition-all placeholder:text-outline-variant max-h-32"></textarea>
        </div>
        <button type="submit" class="p-2.5 sm:px-4 sm:py-2.5 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-md text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0">
          <span class="material-symbols-outlined text-[18px]">send</span>
          <span class="hidden sm:inline">Send</span>
        </button>
      </form>
    </div>

  </div>
</div>

<!-- Report Conversation Modal -->
<div id="reportModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
  <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-space-lg shadow-xl border border-outline-variant/30 space-y-space-md">
    <div class="flex items-center justify-between border-b border-outline-variant/20 pb-2">
      <div class="flex items-center gap-2 text-error">
        <span class="material-symbols-outlined text-[20px]">flag</span>
        <h3 class="font-title-md text-title-md font-bold">Report Conversation</h3>
      </div>
      <button type="button" onclick="document.getElementById('reportModal').classList.add('hidden')" class="p-1 rounded-lg text-outline hover:text-on-surface">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <p class="text-xs text-on-surface-variant">
      Flag inappropriate behavior, abusive messages, or suspicious off-platform payment solicitations to the Nestly moderation desk.
    </p>

    <form action="/chats/<%= chat._id %>/report" method="POST" class="space-y-space-sm">
      <div class="space-y-1">
        <label for="reportReasonInput" class="block font-label-sm text-label-sm text-on-surface font-semibold">Reason for Report</label>
        <textarea id="reportReasonInput" name="reason" rows="3" required placeholder="Describe the issue (e.g. offensive language, asking for off-platform cash transfer)..." class="w-full p-2.5 rounded-xl bg-surface-container-low border border-outline-variant/40 text-xs text-on-surface outline-none focus:border-error focus:ring-1 focus:ring-error"></textarea>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="document.getElementById('reportModal').classList.add('hidden')" class="px-3 py-1.5 rounded-xl bg-surface-container text-on-surface text-xs font-semibold">
          Cancel
        </button>
        <button type="submit" class="px-4 py-1.5 rounded-xl bg-error text-white text-xs font-bold shadow-sm">
          Submit Report
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Auto scroll to bottom
  const container = document.getElementById('messagesContainer');
  if (container) {
    container.scrollTop = container.scrollHeight;
  }

  // Auto grow textarea
  const textarea = document.getElementById('replyTextarea');
  if (textarea) {
    textarea.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = (this.scrollHeight) + 'px';
    });

    // Enter to send (Shift+Enter for newline)
    textarea.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (this.value.trim().length > 0) {
          document.getElementById('replyForm').submit();
        }
      }
    });
  }
</script>
