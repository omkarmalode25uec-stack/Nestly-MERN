<% layout('layouts/boilerplate') %>

<div class="max-w-md mx-auto px-margin-mobile md:px-margin py-space-xl space-y-space-md">
  <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-lg border-2 border-primary/30 space-y-space-md">
    <div class="flex items-center gap-space-sm border-b border-outline-variant/30 pb-space-sm">
      <div class="w-10 h-10 rounded-xl bg-secondary-container flex items-center justify-center text-primary font-bold">
        <span class="material-symbols-outlined text-[24px]">payment</span>
      </div>
      <div>
        <h2 class="font-title-md text-title-md font-bold text-on-surface">ZAP UPI Gateway Sandbox</h2>
        <p class="font-body-sm text-body-sm text-secondary">Local Developer Simulation Mode</p>
      </div>
    </div>

    <div class="bg-surface-container-low p-space-md rounded-xl space-y-2">
      <div class="flex justify-between text-body-sm">
        <span class="text-on-surface-variant">Merchant:</span>
        <span class="font-semibold text-on-surface">Nestly Student Stays</span>
      </div>
      <div class="flex justify-between text-body-sm">
        <span class="text-on-surface-variant">Order ID:</span>
        <span class="font-mono font-semibold text-primary"><%= payment.orderId %></span>
      </div>
      <div class="flex justify-between text-body-sm">
        <span class="text-on-surface-variant">Payable Amount:</span>
        <span class="font-bold text-headline-sm text-primary">₹<%= payment.amount.toLocaleString('en-IN') %></span>
      </div>
      <div class="flex justify-between text-body-sm">
        <span class="text-on-surface-variant">Gateway IP:</span>
        <span class="font-mono text-xs text-outline"><%= process.env.ZAP_UPI_SERVER_GATEWAY_IP || '72.61.225.127' %></span>
      </div>
    </div>

    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
      You are running with test environment credentials. Choose an outcome to test the server-side verification and status transitions:
    </p>

    <div class="space-y-space-xs pt-2">
      <a href="/payments/verify/<%= payment.orderId %>" class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-md transition-all">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span>Simulate Successful UPI Payment</span>
      </a>

      <a href="/payments/simulate-fail/<%= payment.orderId %>" class="w-full py-3 px-4 rounded-xl bg-surface-container hover:bg-error-container text-error font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 transition-all">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span>Simulate Payment Failure (Declined)</span>
      </a>

      <a href="/payments/cancel/<%= payment.orderId %>" class="w-full py-3 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface-variant font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 transition-all">
        <span class="material-symbols-outlined text-[20px]">cancel</span>
        <span>Simulate User Cancellation</span>
      </a>
    </div>
  </div>
</div>
