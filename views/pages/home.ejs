        <!-- Property Type Column -->
        <div class="lg:col-span-2 space-y-1.5">
          <label class="font-label-md text-label-md text-on-surface-variant font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px] text-primary">apartment</span> Stay Type
          </label>
          <div class="relative">
            <select name="type" class="w-full h-12 px-4 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md appearance-none focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary transition-all text-sm cursor-pointer">
              <option value="">All Types</option>
              <option value="PG" selected>Paying Guest (PG)</option>
              <option value="Hostel">Student Hostel</option>
              <option value="Co-Living">Co-Living</option>
              <option value="Shared Flat">Shared Flat</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-3 text-outline text-[20px] pointer-events-none">expand_more</span>
          </div>
        </div>

        <!-- Budget Range Column -->
        <div class="lg:col-span-2 space-y-1.5">
          <label class="font-label-md text-label-md text-on-surface-variant font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px] text-primary">payments</span> Max Budget
