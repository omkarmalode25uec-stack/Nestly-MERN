      <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-secondary-container text-primary flex items-center justify-center mb-space-md">
            <span class="material-symbols-outlined text-[28px]">receipt_long</span>
          </div>
          <h3 class="font-title-md text-title-md text-on-surface mb-space-xs font-bold">100% Transparent Pricing</h3>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            No sudden maintenance surcharges or inflated electricity tariffs. Exact deposit return terms clearly disclosed before booking.
          </p>
        </div>
        <div class="mt-space-md pt-space-xs flex items-center gap-1 text-secondary font-label-sm text-label-sm font-semibold">
          <span>Zero broker commissions</span>
          <span class="material-symbols-outlined text-[16px]">savings</span>
        </div>
      </div>

      <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-secondary-container text-primary flex items-center justify-center mb-space-md">
            <span class="material-symbols-outlined text-[28px]">sentiment_satisfied</span>
          </div>
          <h3 class="font-title-md text-title-md text-on-surface mb-space-xs font-bold">Student-First Amenities</h3>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
            Opt for accommodations with dedicated study rooms, high-speed mesh routers, hygienic home-cooked food, laundry and biometric security.
          </p>
        </div>
        <div class="mt-space-md pt-space-xs flex items-center gap-1 text-secondary font-label-sm text-label-sm font-semibold">
          <span>Designed for campus life</span>
          <span class="material-symbols-outlined text-[16px]">school</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: TRENDING ACCOMMODATIONS IN PUNE (Stitch Featured Loop) -->
<% if (typeof featuredProperties !== 'undefined' && featuredProperties && featuredProperties.length) { %>
  <section class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin py-space-2xl w-full">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
      <div>
        <div class="flex items-center gap-2 text-primary font-label-md text-label-md uppercase tracking-wider mb-1 font-semibold">
          <span class="material-symbols-outlined text-[18px]">local_fire_department</span>
          <span>Verified By Nestly Team</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-bold">Trending Accommodations</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Ready for immediate move-in or priority pre-booking for upcoming academic sessions.</p>
      </div>
      <a class="inline-flex items-center gap-1 font-label-lg text-label-lg text-primary hover:text-on-primary-fixed-variant font-semibold group transition-all" href="/stays">
        <span>Browse all listings</span>
        <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg">
      <% featuredProperties.forEach(function(stay) { %>
        <div class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-outline-variant/30 flex flex-col">
          <div class="relative h-52 overflow-hidden">
            <img class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" alt="<%= stay.title %>" src="<%= (stay.images && stay.images.length) ? stay.images[0] : 'https://lh3.googleusercontent.com/aida-public/AB6AXuBgBDIxb-WpmtqzQeuCJSuSq2xX8QDvXr1slAGbURtXyJxN1EqB7ZQN2uJsIR2IHJAeFy8PJBYdzTUXtXauyeiyJGJ_hIkT7iD6LFwF3Kv2furgx1OFHMa3IgG6pkdwEkXtd1oaVY81xlSKh_4wY83NF4dvK1FY7rV1QydaTNCcnwXskfd2UVBLHS0jGhK42ss_rQBeQ4JTh6BZjWV5_73HR08RwMDZlbIk5AJMDqAewgHwnHt0Qoul' %>"/>
            <div class="absolute top-3 left-3 flex items-center gap-1.5">
              <span class="bg-surface-container-lowest/95 backdrop-blur-sm text-primary font-label-sm text-label-sm font-bold px-2.5 py-1 rounded-full shadow-sm">
                <%= stay.propertyType %>
              </span>
              <span class="bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold px-2.5 py-1 rounded-full">
                <%= stay.genderPreference %>
              </span>
            </div>
            <div class="absolute bottom-3 right-3 bg-surface/95 backdrop-blur-sm text-on-surface px-2.5 py-1 rounded-lg font-label-sm text-label-sm font-bold shadow-sm">
              ₹<%= stay.price.toLocaleString('en-IN') %><span class="text-outline font-normal">/mo</span>
            </div>
          </div>
          <div class="p-space-md flex-1 flex flex-col justify-between space-y-space-sm">
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="font-label-sm text-label-sm text-secondary font-medium"><%= stay.locality %>, <%= stay.city %></span>
                <div class="flex items-center gap-1 text-on-surface">
                  <span class="material-symbols-outlined text-tertiary-container text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                  <span class="font-label-md text-label-md font-bold"><%= stay.rating || 4.8 %></span>
                </div>
              </div>
              <h3 class="font-title-md text-title-md text-on-surface font-bold line-clamp-1"><%= stay.title %></h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-1">
                <span class="material-symbols-outlined text-[16px] text-primary">directions_walk</span>
                <span><%= stay.campusDistance || 'Short walk to campus' %></span>
              </p>
            </div>
            <div class="pt-space-xs border-t border-outline-variant/20 flex items-center justify-between">
              <span class="font-label-sm text-label-sm text-outline"><%= stay.roomSharing %> Sharing</span>
              <a href="/stays/<%= stay._id %>" class="px-3 py-1.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md font-bold transition-colors">
                View Stay
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>
<% } %>

