      <span class="material-symbols-outlined text-secondary text-[18px]">money_off</span>
      <span>Zero Brokerage Direct Connect</span>
    </div>
    <div class="flex items-center gap-2 text-on-surface font-label-sm text-label-sm">
      <span class="material-symbols-outlined text-secondary text-[18px]">lock_clock</span>
      <span>Safe &amp; Curfew-Transparent</span>
    </div>
    <div class="flex items-center gap-2 text-on-surface font-label-sm text-label-sm">
      <span class="material-symbols-outlined text-secondary text-[18px]">shield</span>
      <span>Female-Only &amp; Co-Living Options</span>
    </div>
  </div>
</section>

