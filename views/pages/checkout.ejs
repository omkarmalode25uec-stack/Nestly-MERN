<% layout('layouts/boilerplate') %>

<div class="max-w-xl mx-auto px-margin-mobile md:px-margin py-space-md space-y-space-md">
  <!-- 1. Top Urgency & Hold Card -->
  <div class="bg-surface-container-low rounded-2xl p-space-md shadow-sm space-y-space-sm overflow-hidden relative">
    <div class="flex items-center justify-between gap-space-xs">
      <div class="inline-flex items-center gap-1.5 bg-secondary-container text-on-secondary-container px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold tracking-wide">
        <span class="material-symbols-outlined text-[15px] animate-pulse text-primary">bolt</span>
        <span>PRIORITY BED HOLD ACTIVE</span>
      </div>
      <div class="flex items-center gap-1 text-tertiary-container font-label-md text-label-md bg-tertiary-fixed/60 px-2 py-0.5 rounded-full">
        <span class="material-symbols-outlined text-[14px]">timer</span>
        <span class="font-bold tracking-tight">26:14:08</span>
      </div>
    </div>
    <div class="space-y-1">
      <p class="font-title-md text-title-md text-on-surface font-semibold"><%= bookingDetails.roomNumber %> withheld from public pool</p>
      <p class="font-body-sm text-body-sm text-on-surface-variant">Early-bird semester rate of ₹<%= bookingDetails.monthlyRent.toLocaleString('en-IN') %>/mo is reserved under your student reservation session.</p>
    </div>
    <div class="flex items-center gap-2 bg-surface-container-lowest/80 p-2.5 rounded-lg text-secondary">
      <span class="material-symbols-outlined text-[18px] text-primary shrink-0" style="font-variation-settings: 'FILL' 1;">verified</span>
      <p class="font-body-sm text-body-sm text-on-surface leading-tight">
        <span class="font-semibold text-primary">Visit Verified on 8 Jul</span> by Warden Rajesh Deshmukh • Clean Bill Audit
      </p>
    </div>
  </div>

  <!-- 2. Property & Room Reservation Summary -->
  <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm space-y-space-md border border-outline-variant/30">
    <div class="flex gap-space-md items-start">
      <img class="w-20 h-20 rounded-xl object-cover shrink-0 bg-surface-container" alt="Room preview" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA0VElJyMeK-Gjr7YFbG98rPMT1ZLTkNqv8tDAOFyp9dQrVHULE2C_eEMRVmVs8PZcoRtO9HhOsBWdYmPfxVV3O_FR_30zb-SrEiHS0TI0GYajICnyqIhbQ1ZEpctCdY3M5VTp_bVo6inRhxo0eoKP5G7ScYQqRpVgzOeAKdm1XGqHMktWLXfvtqew3rj_1fcMFDfiGgd-4Go5Ot1XViJJnEEUeFiIU4uXJmp2KkOTlDW4f5cc0vH1t"/>
      <div class="flex-1 min-w-0">
        <div class="inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded text-primary font-label-sm text-label-sm mb-1">
          <span class="material-symbols-outlined text-[12px]">apartment</span>
          <span>Co-Living Residence</span>
        </div>
        <h2 class="font-title-md text-title-md text-on-surface font-semibold truncate"><%= bookingDetails.propertyTitle %></h2>
        <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
          <span class="material-symbols-outlined text-[14px] shrink-0 text-secondary">location_on</span>
          <span class="truncate"><%= bookingDetails.location %></span>
        </p>
      </div>
    </div>
    <div class="bg-surface-container-low rounded-xl p-space-sm space-y-space-xs">
      <div class="flex justify-between items-center text-on-surface">
        <span class="font-label-md text-label-md text-on-surface-variant">Allocated Unit</span>
        <span class="font-label-md text-label-md font-bold text-primary"><%= bookingDetails.roomNumber %></span>
      </div>
      <div class="flex justify-between items-center text-on-surface">
        <span class="font-label-md text-label-md text-on-surface-variant">Balcony Orientation</span>
        <span class="font-label-md text-label-md">Private East Garden View</span>
      </div>
      <div class="flex justify-between items-center text-on-surface">
        <span class="font-label-md text-label-md text-on-surface-variant">Contract Term</span>
        <span class="font-label-md text-label-md">10 Months Academic Term</span>
      </div>
    </div>
  </div>

  <!-- 3. Secure Payment & Booking Banner -->
  <div class="bg-surface-container-low rounded-2xl p-space-md shadow-sm space-y-space-sm relative overflow-hidden">
    <div class="flex items-start gap-3">
      <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-primary">
        <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">shield_with_heart</span>
      </div>
      <div>
        <h3 class="font-title-md text-title-md font-bold text-primary">Secure Payment Processing</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
          Your payment of ₹<%= (bookingDetails.payableAmount || bookingDetails.monthlyRent).toLocaleString('en-IN') %> is processed securely through our payment gateway to confirm and hold your room reservation.
        </p>
      </div>
    </div>
    <div class="space-y-1.5 pt-1 pl-1">
      <div class="flex items-start gap-2">
        <span class="material-symbols-outlined text-[17px] text-primary shrink-0 mt-0.5">check_circle</span>
        <p class="font-body-sm text-body-sm text-on-surface"><span class="font-semibold">Instant confirmation</span> directly linked to your student reservation</p>
      </div>
      <div class="flex items-start gap-2">
        <span class="material-symbols-outlined text-[17px] text-primary shrink-0 mt-0.5">check_circle</span>
        <p class="font-body-sm text-body-sm text-on-surface"><span class="font-semibold">Transparent pricing</span> with clear breakdown of rent and fees</p>
      </div>
    </div>
  </div>

  <!-- 4. Transparent Payment Breakdown Ledger -->
  <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm space-y-space-md border border-outline-variant/30">
    <div class="flex items-center justify-between">
      <h3 class="font-title-md text-title-md text-on-surface font-semibold">Settlement Ledger</h3>
      <span class="font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded text-secondary font-semibold">Clear-Split Policy</span>
    </div>
    <div class="space-y-2.5">
      <div class="flex justify-between items-center text-body-md font-body-md text-on-surface-variant">
        <span>Monthly Room Rent (Aug)</span>
        <span class="text-on-surface font-medium">₹<%= bookingDetails.monthlyRent.toLocaleString('en-IN') %></span>
      </div>
      <div class="flex justify-between items-center text-body-md font-body-md text-on-surface-variant">
        <span>Refundable Security Deposit (1 Mo)</span>
        <span class="text-on-surface font-medium">₹<%= bookingDetails.securityDeposit.toLocaleString('en-IN') %></span>
      </div>
      <div class="flex justify-between items-center text-body-md font-body-md text-on-surface-variant">
        <div class="flex items-center gap-1">
          <span>Nestly Platform Service Fee</span>
          <span class="material-symbols-outlined text-[14px] text-secondary">info</span>
        </div>
        <span class="text-primary font-medium flex items-center gap-1">
          <span class="line-through text-outline text-body-sm font-body-sm">₹999</span>
          <span>₹0 (Student Pass)</span>
        </span>
      </div>
      <div class="h-px bg-surface-container-highest my-1"></div>
      <div class="flex justify-between items-center pt-0.5">
        <div>
          <div class="font-title-md text-title-md font-bold text-on-surface">First Month Rent Payable Today</div>
          <div class="font-body-sm text-body-sm text-secondary">Secures your bed reservation via payment gateway</div>
        </div>
        <div class="text-right">
          <span class="font-headline-sm text-headline-sm font-bold text-primary">₹<%= (bookingDetails.payableAmount || bookingDetails.monthlyRent).toLocaleString('en-IN') %></span>
          <div class="font-label-sm text-label-sm text-secondary font-semibold">Direct Booking Hold</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. Payment Submission Form (POST to /payments/create-order) -->
  <form action="/payments/create-order" method="POST" class="space-y-space-md">
    <input type="hidden" name="propertyTitle" value="<%= bookingDetails.propertyTitle %>"/>
    <input type="hidden" name="roomNumber" value="<%= bookingDetails.roomNumber %>"/>
    <input type="hidden" name="customerName" value="<%= bookingDetails.residentName %>"/>
    <input type="hidden" name="customerMobile" value="<%= bookingDetails.residentPhone || '9876543210' %>"/>
    <% if (bookingDetails.bookingId) { %>
      <input type="hidden" name="bookingId" value="<%= bookingDetails.bookingId %>"/>
    <% } %>

    <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm space-y-space-sm border border-outline-variant/30 ring-2 ring-primary">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-primary font-bold">
            <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-label-lg text-label-lg font-bold text-on-surface">Instant UPI via ZAP</span>
              <span class="font-label-sm text-label-sm bg-secondary-container text-on-secondary-container px-1.5 py-0.2 rounded font-semibold">0% Surcharge</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Google Pay, PhonePe, Paytm, BHIM</p>
          </div>
        </div>
        <span class="material-symbols-outlined text-primary text-[22px]">radio_button_checked</span>
      </div>

      <div class="pt-2 border-t border-surface-container-highest flex items-center justify-between text-body-sm font-body-sm text-secondary px-1">
        <span class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px] text-primary">shield</span>
          <span>Official ZapUPI Hosted Payment Gateway</span>
        </span>
        <span class="font-medium text-primary">Secure Checkout</span>
      </div>
    </div>

    <!-- Action Pay Button -->
    <button type="submit" class="w-full h-14 bg-primary hover:bg-on-primary-fixed-variant active:scale-[0.98] transition-all text-on-primary rounded-2xl font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20">
      <span>Pay First Month Rent ₹<%= (bookingDetails.payableAmount || bookingDetails.monthlyRent).toLocaleString('en-IN') %></span>
      <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
    </button>

    <!-- Trust Badges -->
    <div class="flex items-center justify-center gap-2 text-outline text-label-sm font-label-sm pt-2">
      <span class="material-symbols-outlined text-[14px] text-primary">lock</span>
      <span>Secure Payment Gateway</span>
      <span>•</span>
      <span>Powered by ZAP UPI Gateway</span>
    </div>
  </form>
</div>
