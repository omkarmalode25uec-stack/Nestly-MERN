<% layout('layouts/boilerplate') %>

<div class="max-w-xl mx-auto px-margin-mobile md:px-margin py-space-md space-y-space-md">
  <!-- Animated Badge & Header -->
  <div class="relative w-full overflow-hidden pt-space-md pb-space-lg flex flex-col items-center text-center">
    <div class="relative z-10 flex items-center justify-center mb-space-md">
      <div class="w-20 h-20 rounded-full bg-secondary-container flex items-center justify-center shadow-lg relative">
        <div class="absolute inset-0 rounded-full bg-primary-fixed-dim/40 animate-ping opacity-60"></div>
        <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-md">
          <span class="material-symbols-outlined text-[34px]" style="font-variation-settings: 'FILL' 1;">verified</span>
        </div>
      </div>
    </div>

    <!-- Celebration Title & Subtitle -->
    <div class="relative z-10 space-y-space-xs">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-low text-primary text-label-sm font-label-sm tracking-wide uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        Escrow Deposit Confirmed
      </div>
      <h2 class="font-display text-display-mobile lg:text-headline-lg text-on-background tracking-tight">
        Bed Reserved & Protected!
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        First month rent of <span class="font-title-md text-primary font-bold">₹<%= payment.amount.toLocaleString('en-IN') %></span> safely held in <strong class="text-on-background">ZAP UPI Escrow Vault</strong>.
      </p>
    </div>

    <!-- Escrow Reference Micro-Panel -->
    <div class="relative z-10 mt-space-md w-full bg-surface-container-lowest rounded-2xl p-space-sm shadow-sm flex items-center justify-between gap-space-xs border border-outline-variant/30">
      <div class="flex items-center gap-space-xs min-w-0 pl-2">
        <span class="material-symbols-outlined text-secondary text-[20px]">account_balance</span>
        <div class="flex flex-col text-left truncate">
          <span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Escrow Reference ID</span>
          <span class="font-title-md text-title-md text-primary font-mono tracking-tight font-bold truncate"><%= payment.orderId %></span>
        </div>
      </div>
      <span class="px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold">
        Verified
      </span>
    </div>
  </div>

  <!-- Digital Bed Allotment & Unit Certificate Card -->
  <div class="relative bg-surface-container-lowest rounded-2xl p-space-md shadow-sm border border-outline-variant/30 space-y-space-md">
    <div class="flex items-start justify-between gap-space-xs">
      <div>
        <div class="flex items-center gap-1 text-primary mb-1">
          <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
          <span class="font-label-sm text-label-sm font-bold tracking-wider uppercase">Official Allocation Pass</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-background"><%= payment.propertyTitle %></h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
          <span class="material-symbols-outlined text-[14px] text-secondary">location_on</span>
          Baner Road, Pune • Verified Campus Zone
        </p>
      </div>
      <div class="flex flex-col items-end shrink-0">
        <div class="flex items-center gap-0.5 bg-surface-container-low px-2 py-1 rounded-md text-on-background">
          <span class="material-symbols-outlined text-[14px] text-tertiary-container" style="font-variation-settings: 'FILL' 1;">star</span>
          <span class="font-label-md text-label-md font-bold">4.9</span>
        </div>
        <span class="font-label-sm text-label-sm text-outline mt-1">Verified Nest</span>
      </div>
    </div>

    <!-- Suite & Resident Grid -->
    <div class="bg-surface-container-low rounded-xl p-space-sm space-y-space-sm">
      <div class="flex items-center justify-between pb-space-xs border-b border-outline-variant/30">
        <span class="font-label-md text-label-md text-on-surface-variant">Allocated Bed Space</span>
        <span class="font-title-md text-title-md text-primary font-bold"><%= payment.roomNumber %></span>
      </div>
      <div class="flex items-center justify-between text-body-sm font-body-sm text-on-surface">
        <span class="text-on-surface-variant">Resident</span>
        <span class="font-semibold"><%= payment.customerName %></span>
      </div>
      <div class="flex items-center justify-between text-body-sm font-body-sm text-on-surface">
        <span class="text-on-surface-variant">Transaction ID</span>
        <span class="font-mono text-secondary font-semibold"><%= payment.transactionId || 'TXN-ZAP-' + payment.orderId.split('-').pop() %></span>
      </div>
      <div class="flex items-center justify-between text-body-sm font-body-sm text-on-surface">
        <span class="text-on-surface-variant">Bank UTR</span>
        <span class="font-mono text-on-surface font-semibold"><%= payment.utr || '987625148901' %></span>
      </div>
      <div class="flex items-center justify-between text-body-sm font-body-sm text-on-surface">
        <span class="text-on-surface-variant">Deposit Amount Transferred</span>
        <span class="font-title-md text-title-md text-primary font-bold">₹<%= payment.amount.toLocaleString('en-IN') %>.00</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="pt-2 flex flex-col sm:flex-row gap-space-sm">
      <% if (payment.booking) { %>
        <a href="/bookings/<%= payment.booking %>" class="flex-1 py-3 px-4 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-lg text-label-lg font-bold text-center transition-all shadow-md flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-[18px]">receipt_long</span>
          <span>View Booking Pass</span>
        </a>
      <% } else { %>
        <a href="/bookings" class="flex-1 py-3 px-4 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-lg text-label-lg font-bold text-center transition-all shadow-md">
          View My Bookings
        </a>
      <% } %>
      <a href="/stays" class="py-3 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-lg text-label-lg font-semibold text-center transition-all">
        Explore More Stays
      </a>
    </div>
  </div>
</div>
