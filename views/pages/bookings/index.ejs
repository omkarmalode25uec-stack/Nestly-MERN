<% layout('layouts/boilerplate') %>

<div class="relative w-full min-h-[calc(100vh-80px)] bg-surface py-space-xl">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin space-y-space-xl">

    <!-- Top Context & Breadcrumb -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-sm border-b border-outline-variant/30">
      <div class="space-y-space-xs max-w-2xl">
        <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md">
          <a class="hover:text-primary transition-colors" href="/">Home</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <a class="hover:text-primary transition-colors" href="/profile">Student Dashboard</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-primary font-semibold">My Bookings</span>
        </nav>
        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">My Bookings &amp; Enquiries</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Track your accommodation reservation requests, token hold certificates, and host confirmations.
        </p>
      </div>

      <div class="flex items-center gap-space-sm shrink-0">
        <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-sm hover:bg-on-primary-fixed-variant transition-colors" href="/stays">
          <span class="material-symbols-outlined text-[18px]">search</span>
          <span>Explore More Stays</span>
        </a>
      </div>
    </div>

    <!-- Summary Metrics Grid (Stitch Component) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-md">
      <!-- Total Tracked -->
      <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex items-center justify-between border border-outline-variant/30">
        <div class="space-y-1">
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Total Requests</span>
          <p class="font-headline-md text-headline-md text-on-surface font-bold"><%= bookings.length %></p>
          <span class="font-body-sm text-body-sm text-secondary">Student tenancy requests</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0">
          <span class="material-symbols-outlined text-[26px]">apartment</span>
        </div>
      </div>

      <!-- Confirmed Beds -->
      <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex items-center justify-between border border-outline-variant/30">
        <div class="space-y-1">
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Confirmed &amp; Allotted</span>
          <p class="font-headline-md text-headline-md text-emerald-700 font-bold">
            <%= bookings.filter(b => b.status === 'confirmed').length %> Active
          </p>
          <span class="font-body-sm text-body-sm text-emerald-600">Unit hold secured</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 shrink-0">
          <span class="material-symbols-outlined text-[26px]">verified</span>
        </div>
      </div>

      <!-- Pending Approval -->
      <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex items-center justify-between border border-outline-variant/30">
        <div class="space-y-1">
          <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Pending Host Review</span>
          <p class="font-headline-md text-headline-md text-amber-700 font-bold">
            <%= bookings.filter(b => b.status === 'pending').length %> Under Review
          </p>
          <span class="font-body-sm text-body-sm text-amber-600">Decision in 24h</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 shrink-0">
          <span class="material-symbols-outlined text-[26px]">pending_actions</span>
        </div>
      </div>
    </div>

    <!-- Main Bookings Cards Feed -->
    <% if (bookings && bookings.length > 0) { %>
      <div class="space-y-space-md">
        <% bookings.forEach(booking => { %>
          <article class="p-space-md md:p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all border border-outline-variant/30 flex flex-col md:flex-row gap-space-md justify-between items-start md:items-center">
            
            <!-- Left: Property Details -->
            <div class="flex items-start gap-space-md">
              <img class="w-20 h-20 md:w-24 md:h-24 rounded-xl object-cover shrink-0 bg-surface-container" alt="<%= booking.property ? booking.property.title : 'Stay' %>" src="<%= booking.property && booking.property.images && booking.property.images.length ? booking.property.images[0] : 'https://lh3.googleusercontent.com/aida-public/AB6AXuBgBDIxb-WpmtqzQeuCJSuSq2xX8QDvXr1slAGbURtXyJxN1EqB7ZQN2uJsIR2IHJAeFy8PJBYdzTUXtXauyeiyJGJ_hIkT7iD6LFwF3Kv2furgx1OFHMa3IgG6pkdwEkXtd1oaVY81xlSKh_4wY83NF4dvK1FY7rV1QydaTNCcnwXskfd2UVBLHS0jGhK42ss_rQBeQ4JTh6BZjWV5_73HR08RwMDZlbIk5AJMDqAewgHwnHt0Qoul' %>"/>
              
              <div class="space-y-1">
                <!-- Status Badge -->
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold uppercase <%= booking.status === 'confirmed' ? 'bg-emerald-100 text-emerald-800' : (booking.status === 'rejected' ? 'bg-red-100 text-red-800' : (booking.status === 'cancelled' ? 'bg-gray-100 text-gray-700' : 'bg-amber-100 text-amber-800')) %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= booking.status === 'confirmed' ? 'bg-emerald-600' : (booking.status === 'rejected' ? 'bg-red-600' : (booking.status === 'cancelled' ? 'bg-gray-600' : 'bg-amber-600 animate-pulse')) %>"></span>
                    <span><%= booking.status %></span>
                  </span>
                  <span class="text-xs font-mono text-outline font-semibold"><%= booking.referenceCode %></span>
                </div>

                <h3 class="font-title-lg text-title-lg text-on-surface font-bold">
                  <a href="/stays/<%= booking.property ? booking.property._id : '#' %>" class="hover:text-primary transition-colors">
                    <%= booking.property ? booking.property.title : 'Accommodation' %>
                  </a>
                </h3>

                <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1">
                  <span class="material-symbols-outlined text-[15px] text-secondary">location_on</span>
                  <span><%= booking.property ? (booking.property.locality + ', ' + booking.property.city) : 'Pune' %></span>
                </p>

                <p class="font-body-sm text-body-sm text-on-surface-variant">
                  Move-In: <strong><%= new Date(booking.moveInDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong> • Rent: <span class="font-bold text-tertiary-container">₹<%= booking.monthlyRent.toLocaleString('en-IN') %>/mo</span>
                </p>
              </div>
            </div>

            <!-- Right: Action Buttons -->
            <div class="flex items-center gap-2 w-full md:w-auto justify-end pt-2 md:pt-0 border-t md:border-0 border-surface-container">
              <a href="/bookings/<%= booking._id %>" class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold transition-all shadow-sm flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                <span>View Pass</span>
              </a>

              <% if (booking.paymentStatus !== 'completed' && booking.status !== 'cancelled' && booking.status !== 'rejected') { %>
                <a href="/checkout?bookingId=<%= booking._id %>" class="px-4 py-2 rounded-xl bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-md text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px]">payment</span>
                  <span>Pay Rent</span>
                </a>
              <% } %>

              <% if (booking.status === 'pending') { %>
                <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking request?');" class="inline">
                  <button type="submit" class="px-3 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-error font-label-md text-label-md font-medium transition-colors">
                    Cancel
                  </button>
                </form>
              <% } %>
            </div>

          </article>
        <% }) %>
      </div>
    <% } else { %>
      <!-- Empty State (Stitch Component) -->
      <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-space-2xl text-center max-w-xl mx-auto shadow-sm space-y-space-md">
        <div class="w-20 h-20 mx-auto rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center">
          <span class="material-symbols-outlined text-[36px] text-primary">calendar_month</span>
        </div>
        <div class="space-y-1">
          <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">No Bookings Yet</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-sm mx-auto">
            You haven't requested any student accommodations yet. Browse verified student PGs and hostels near your university to hold your bed with zero brokerage!
          </p>
        </div>
        <div class="pt-2">
          <a href="/stays" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold hover:bg-on-primary-fixed-variant transition-all shadow-md">
            <span class="material-symbols-outlined text-[18px]">search</span>
            <span>Explore Stays</span>
          </a>
        </div>
      </div>
    <% } %>

  </div>
</div>
