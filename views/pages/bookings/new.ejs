<% layout('layouts/boilerplate') %>

<div class="relative w-full min-h-[calc(100vh-80px)] bg-surface py-space-lg">
  <div class="max-w-3xl mx-auto px-margin-mobile md:px-margin space-y-space-md">

    <!-- Top Breadcrumb & Status Nav -->
    <div class="flex items-center justify-between gap-space-xs text-on-surface-variant font-label-md text-label-md">
      <div class="flex items-center gap-space-xs">
        <a href="/stays/<%= property._id %>" class="hover:text-primary transition-colors flex items-center gap-1 font-semibold">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          <span>Back to Stay</span>
        </a>
        <span class="text-outline-variant">/</span>
        <span class="text-on-surface font-semibold truncate max-w-[220px]">Reserve Unit</span>
      </div>
      <div class="flex items-center gap-1 bg-secondary-container text-on-secondary-container px-2.5 py-1 rounded-full text-xs font-semibold">
        <span class="material-symbols-outlined text-[14px] text-primary">verified_user</span>
        <span>256-Bit Escrow Vault</span>
      </div>
    </div>

    <!-- 1. Priority Bed Hold Urgency Card (Stitch Component) -->
    <div class="bg-surface-container-low rounded-2xl p-space-md shadow-sm space-y-space-sm overflow-hidden relative border border-outline-variant/30">
      <div class="flex items-center justify-between gap-space-xs flex-wrap">
        <div class="inline-flex items-center gap-1.5 bg-secondary-container text-on-secondary-container px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold tracking-wide">
          <span class="material-symbols-outlined text-[15px] text-primary animate-pulse">bolt</span>
          <span>PRIORITY BED HOLD ACTIVE</span>
        </div>
        <div class="flex items-center gap-1 text-tertiary-container font-label-md text-label-md bg-tertiary-fixed/60 px-2.5 py-0.5 rounded-full font-bold">
          <span class="material-symbols-outlined text-[15px]">timer</span>
          <span>Hold Window: 24 Hours</span>
        </div>
      </div>
      <div class="space-y-1">
        <p class="font-title-md text-title-md text-on-surface font-bold">
          <%= property.roomSharing %> Room Unit Reserved under Session
        </p>
        <p class="font-body-sm text-body-sm text-on-surface-variant">
          Rate of ₹<%= property.price.toLocaleString('en-IN') %>/mo is protected. First month rent is ₹<%= property.price.toLocaleString('en-IN') %> and 100% refundable upon cancellation prior to check-in confirmation.
        </p>
      </div>
      <div class="flex items-center gap-2 bg-surface-container-lowest/90 p-2.5 rounded-xl text-secondary border border-outline-variant/20">
        <span class="material-symbols-outlined text-[18px] text-primary shrink-0" style="font-variation-settings: 'FILL' 1;">verified</span>
        <p class="font-body-sm text-body-sm text-on-surface leading-tight">
          <span class="font-semibold text-primary">Nestly Verified Quality Audit</span> by Resident Quality Manager • Clean Bill Approved
        </p>
      </div>
    </div>

    <!-- Main Booking Form -->
    <form action="/stays/<%= property._id %>/book" method="POST" class="space-y-space-md" id="bookingForm">
      
      <!-- 2. Property & Room Reservation Summary Card -->
      <div class="bg-surface-container-lowest rounded-2xl p-space-md md:p-space-lg shadow-sm space-y-space-md border border-outline-variant/30">
        <div class="flex gap-space-md items-start">
          <img class="w-24 h-24 rounded-xl object-cover shrink-0 bg-surface-container" alt="<%= property.title %>" src="<%= property.images && property.images.length ? property.images[0] : 'https://lh3.googleusercontent.com/aida-public/AB6AXuBgBDIxb-WpmtqzQeuCJSuSq2xX8QDvXr1slAGbURtXyJxN1EqB7ZQN2uJsIR2IHJAeFy8PJBYdzTUXtXauyeiyJGJ_hIkT7iD6LFwF3Kv2furgx1OFHMa3IgG6pkdwEkXtd1oaVY81xlSKh_4wY83NF4dvK1FY7rV1QydaTNCcnwXskfd2UVBLHS0jGhK42ss_rQBeQ4JTh6BZjWV5_73HR08RwMDZlbIk5AJMDqAewgHwnHt0Qoul' %>"/>
          <div class="flex-1 min-w-0 space-y-1">
            <div class="inline-flex items-center gap-1 bg-surface-container px-2 py-0.5 rounded text-primary font-label-sm text-label-sm">
              <span class="material-symbols-outlined text-[13px]">apartment</span>
              <span><%= property.propertyType %> • <%= property.genderPreference %></span>
            </div>
            <h2 class="font-title-lg text-title-lg text-on-surface font-bold truncate"><%= property.title %></h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1">
              <span class="material-symbols-outlined text-[15px] shrink-0 text-secondary">location_on</span>
              <span class="truncate"><%= property.address %>, <%= property.locality %>, <%= property.city %></span>
            </p>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-space-sm space-y-space-xs">
          <div class="flex justify-between items-center text-on-surface text-sm">
            <span class="text-on-surface-variant">Occupancy Tier</span>
            <span class="font-bold text-primary"><%= property.roomSharing %> Room</span>
          </div>
          <div class="flex justify-between items-center text-on-surface text-sm">
            <span class="text-on-surface-variant">Campus Proximity</span>
            <span class="font-semibold"><%= property.campusDistance %></span>
          </div>
          <div class="flex justify-between items-center text-on-surface text-sm">
            <span class="text-on-surface-variant">Available Inventory</span>
            <span class="font-semibold text-secondary"><%= property.availableBeds %> Beds Left</span>
          </div>
        </div>

        <!-- Move-in Date Picker & Duration Form Controls -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm pt-1">
          <div class="space-y-1">
            <label for="moveInDate" class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Planned Move-In Date</label>
            <input type="date" id="moveInDate" name="moveInDate" required class="w-full p-2.5 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary" value="<%= new Date(Date.now() + 1000 * 60 * 60 * 24 * 7).toISOString().split('T')[0] %>"/>
          </div>
          <div class="space-y-1">
            <label for="durationMonths" class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Tenure / Contract Term</label>
            <select id="durationMonths" name="durationMonths" class="w-full p-2.5 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary font-medium">
              <option value="10" selected>10 Months (Academic Term)</option>
              <option value="6">6 Months (Semester Lease)</option>
              <option value="12">12 Months (Full Calendar Year)</option>
            </select>
          </div>
        </div>

        <!-- Dietary Preference Selection -->
        <div class="space-y-1">
          <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Mess &amp; Food Preference</label>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer border border-outline-variant/30 text-xs font-semibold text-on-surface has-[:checked]:bg-secondary-container has-[:checked]:border-primary transition-all">
              <input type="radio" name="dietaryPreference" value="Veg" checked class="accent-primary"/>
              <span>Pure Veg Included</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low cursor-pointer border border-outline-variant/30 text-xs font-semibold text-on-surface has-[:checked]:bg-secondary-container has-[:checked]:border-primary transition-all">
              <input type="radio" name="dietaryPreference" value="Non-Veg" class="accent-primary"/>
              <span>Veg + Non-Veg</span>
            </label>
          </div>
        </div>

        <!-- Student Note / Requests -->
        <div class="space-y-1">
          <label for="studentNotes" class="block font-label-sm text-label-sm text-on-surface-variant uppercase font-semibold">Special Request or Notes for Warden</label>
          <textarea id="studentNotes" name="studentNotes" rows="2" placeholder="e.g. Need high study desk, prefer upper bunk or quiet side wing..." class="w-full p-2.5 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface border border-outline-variant/30 focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
        </div>
      </div>

      <!-- 3. Escrow Protection Guarantee Banner (Stitch Component) -->
      <div class="bg-surface-container-low rounded-2xl p-space-md shadow-sm space-y-space-sm border border-outline-variant/30">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-primary">
            <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">shield_with_heart</span>
          </div>
          <div>
            <h3 class="font-title-md text-title-md font-bold text-primary">100% Escrow Protection Protocol</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
              Your first month rent of ₹<%= property.price.toLocaleString('en-IN') %> is safely held in escrow. It is released to the property owner ONLY after you physically inspect the unit and accept key handover.
            </p>
          </div>
        </div>
        <div class="space-y-1.5 pt-1 pl-1">
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5">check_circle</span>
            <p class="font-body-sm text-body-sm text-on-surface"><span class="font-semibold">Full 100% refund</span> if cancelled prior to check-in confirmation.</p>
          </div>
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5">check_circle</span>
            <p class="font-body-sm text-body-sm text-on-surface"><span class="font-semibold">Zero brokerage &amp; zero hidden ledger charges</span> guaranteed.</p>
          </div>
        </div>
      </div>

      <!-- 4. Transparent Settlement Ledger -->
      <div class="bg-surface-container-lowest rounded-2xl p-space-md md:p-space-lg shadow-sm space-y-space-md border border-outline-variant/30">
        <div class="flex items-center justify-between">
          <h3 class="font-title-md text-title-md text-on-surface font-bold">Settlement Ledger</h3>
          <span class="font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded text-secondary font-semibold">Zero Brokerage</span>
        </div>
        <div class="space-y-2 text-body-sm">
          <div class="flex justify-between items-center text-on-surface-variant">
            <span>Monthly Room Rent</span>
            <span class="text-on-surface font-semibold">₹<%= property.price.toLocaleString('en-IN') %></span>
          </div>
          <div class="flex justify-between items-center text-on-surface-variant">
            <span>Security Deposit (Refundable)</span>
            <span class="text-on-surface font-semibold">₹<%= property.securityDeposit.toLocaleString('en-IN') %></span>
          </div>
          <div class="flex justify-between items-center text-on-surface-variant">
            <span>Platform Fee (Student Pass)</span>
            <span class="text-primary font-semibold flex items-center gap-1">
              <span class="line-through text-outline text-xs">₹999</span>
              <span>₹0 (Free)</span>
            </span>
          </div>
          <div class="h-px bg-surface-container-highest my-2"></div>
          <div class="flex justify-between items-center pt-0.5">
            <div>
              <div class="font-title-md text-title-md font-bold text-on-surface">First Month Rent Payable Today</div>
              <div class="font-body-sm text-body-sm text-secondary">Secures your bed reservation under 100% Escrow Protection</div>
            </div>
            <div class="text-right">
              <span class="font-headline-sm text-headline-sm font-bold text-primary">₹<%= property.price.toLocaleString('en-IN') %></span>
              <div class="font-label-sm text-label-sm text-secondary font-semibold">100% Refundable</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Resident Credentials (Pre-filled from session) -->
      <div class="bg-surface-container-lowest rounded-2xl p-space-md md:p-space-lg shadow-sm space-y-space-md border border-outline-variant/30">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
            <h3 class="font-title-md text-title-md text-on-surface font-bold">Resident Credentials</h3>
          </div>
          <span class="font-label-sm text-label-sm text-primary font-semibold flex items-center gap-1 bg-secondary-container/50 px-2 py-0.5 rounded">
            <span class="material-symbols-outlined text-[13px]">verified</span> Verified Student
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-sm">
          <div class="bg-surface-container-low p-space-sm rounded-xl">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Primary Resident</span>
            <p class="font-label-md text-label-md text-on-surface font-bold mt-0.5"><%= user.name %></p>
          </div>
          <div class="bg-surface-container-low p-space-sm rounded-xl">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Contact Mobile</span>
            <p class="font-label-md text-label-md text-on-surface font-semibold mt-0.5"><%= user.phone || 'Provided upon submission' %></p>
          </div>
          <div class="bg-surface-container-low p-space-sm rounded-xl sm:col-span-2">
            <span class="font-label-sm text-label-sm text-on-surface-variant">Campus / College</span>
            <p class="font-label-md text-label-md text-on-surface font-semibold mt-0.5"><%= user.college || 'Student Member' %></p>
          </div>
        </div>
      </div>

      <!-- 6. Submit Button & Trust Footnote -->
      <div class="pt-space-sm space-y-3">
        <button type="submit" class="w-full py-4 px-6 rounded-2xl bg-primary hover:bg-on-primary-fixed-variant active:scale-[0.99] transition-all text-on-primary font-label-lg text-label-lg font-bold flex items-center justify-center gap-2 shadow-lg shadow-primary/20">
          <span>Submit Reservation Request</span>
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </button>

        <div class="flex items-center justify-center gap-2 text-outline text-label-sm font-label-sm text-center">
          <span class="material-symbols-outlined text-[14px] text-primary">lock</span>
          <span>Bank-Grade Escrow Vault Protection</span>
          <span>•</span>
          <span>Zero Commission Guarantee</span>
        </div>
      </div>

    </form>
  </div>
</div>
