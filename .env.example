# Server Configuration
PORT=3000
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nestly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nestly
SESSION_SECRET=your_session_secret_key

# Payment Gateway (ZapUPI)
ZAP_UPI_API_KEY=YOUR_ZAP_UPI_API_KEY
ZAP_UPI_SERVER_GATEWAY_IP=72.61.225.127
ZAP_UPI_BASE_URL=https://pay.zapupi.com
ZAP_UPI_SIMULATION=true

# Cloudinary (Property Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Mapbox (Property Location Picker & Maps)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
