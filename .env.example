# ==========================================
# Nestly Environment Configuration Template
# (Copy this file to .env and supply values)
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Management
# Provide a 64+ char random string for session cookie encryption in production
SESSION_SECRET=your_super_secret_session_key_here

# Database Configuration
# In production, specify your MongoDB Atlas connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nestly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nestly

# ZAP UPI Payment Gateway Configuration
# Obtained from ZapUPI Merchant Dashboard: https://zapupi.com
ZAP_UPI_API_KEY=your_zap_upi_api_key_here
ZAP_UPI_SERVER_GATEWAY_IP=72.61.225.127
ZAP_UPI_BASE_URL=https://pay.zapupi.com

# Payment Sandbox Mode
# Set to 'true' for local developer testing and staging simulation
# Set to 'false' for live production UPI escrow transactions
ZAP_UPI_SIMULATION=true
